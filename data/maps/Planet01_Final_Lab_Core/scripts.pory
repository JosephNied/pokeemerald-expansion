mapscripts Planet01_Final_Lab_Core_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_Final_Lab_Core_Enter
	MAP_SCRIPT_ON_FRAME_TABLE: Planet01_Final_Lab_Core_FrameTable
}

script Planet01_Final_Lab_Core_Enter {
	getplayerxy(VAR_0x8004, VAR_0x8005)
    compare (VAR_0x8004, 0)
    goto_if_ne(OtherEnter, 0)
    compare (VAR_0x8005, 2)
    goto_if_ne(OtherEnter, 0)
	setflashlevel(5)
	setvar(VAR_TEMP_3, 1)

OtherEnter:
	getplayerxy(VAR_0x8004, VAR_0x8005)
    compare (VAR_0x8004, 20)
    goto_if_ne(EndB, 0)
    compare (VAR_0x8005, 24)
    goto_if_ne(EndB, 0)
	setflashlevel(0)
	setvar(VAR_TEMP_4, 1)

EndB:
	end
}

raw `
Planet01_Final_Lab_Core_FrameTable::
	map_script_2 VAR_TEMP_3, 1, Planet01_Final_Lab_Core_BeheeWalk
	map_script_2 VAR_TEMP_4, 1, Planet01_Final_Lab_Core_FinalFight
	.2byte 0
`

script Planet01_Final_Lab_Core_FinalFight{
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Deoxys1)
	waitmovement(0)
	applymovement(1, Movement_Deoxys2)
	waitmovement(0)
	fadeScreen(FADE_TO_BLACK)
	setflag(FLAG_UNUSED_0x054)
	removeobject(1)
	setvar(VAR_0x8000, SPECIES_DEOXYS_NORMAL)
    callnative(RegisterSpeciesInDex)
	trainerbattle_single(TRAINER_WALTER_5, DeoxysBattle_Intro, DeoxysBattle_Outro)
	setflag(FLAG_MAP_SCRIPT_CHECKED_DEOXYS)
	setflag(FLAG_DEOXYS_ROCK_COMPLETE)
	clearflag(FLAG_ENABLE_SHIP_BIRTH_ISLAND)
	warp(MAP_PLANET01_FINAL_LAB_INTERIOR, 2, 15, 1)
    waitstate
	release
	end
}

movement Movement_Deoxys1 {
	delay_16
	delay_16
	walk_up
	walk_up
	walk_up
	face_up
}

movement Movement_Deoxys2 {
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
}

text DeoxysBattle_Intro {
	"Here it comes! Brace yourself!"
}

text DeoxysBattle_Outro {
	"...It's over. The cell dissolves."
}

script Planet01_Final_Lab_Core_BeheeWalk {
	lock
	msgbox("...Where am I?")
	waitmessage
	closemessage
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee1)
    waitmovement(0)
	msgbox("M-my parents?\n"
	"...\p" 
	"I love them, and they love me. But I\n" 
	"know they'd be disappointed that I no\l"
	"longer believe the things they do, and\l"
	"in the choices I've made. It's easier...\l"
	"To just avoid them...")
	waitmessage
	closemessage
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee1)
    waitmovement(0)
	msgbox("My friends. So many memories of them...\n"
	"They always seem to express their\l"
	"feelings and who they are so easily, and\l"
	"they accept everybody as they are.\l"
	"Even me.\p"
	"I feel so selfish and jealous.\n"
	"Why couldn't I ever be that way?")
	waitmessage
	closemessage
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee1)
    waitmovement(0)
	msgbox("...You asked me if I loved myself. When I\n"
	"laughed and said Of course not!, you \l" 
	"told me that it broke your heart, \l" 
	"because you loved me.\p"
	"...I resolved to love myself. But, even \n"
	"now I'm not sure I know how to do it.")
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee2)
    waitmovement(0)
	waitse()
    playmoncry(SPECIES_BEHEEYEM, CRY_MODE_ENCOUNTER)
    waitmoncry()
	msgbox("And now I may never get the chance. I\n"
	"never appreciated just how pathetic it\l"
	"is that even when I'm surrounded by\l"
	"people who love and support me, I\l"
	"choose to make myself miserable.\p"
	"And I may never get fix any of this\n"
	"broken shit, because I chose to\l"
	"distract myself and escape instead.\l"
	"Is that... What you wanted to show me?")
	setvar(VAR_0x8000, SPECIES_BEHEEYEM)
    callnative(RegisterSpeciesInDex)
	warp(MAP_PLANET01_01, 1, 31, 11)
    waitstate
    release
    end
}

movement Movement_Player_Behee1 {
	face_right
	delay_16
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	face_up
	delay_16
}

movement Movement_Player_Behee2 {
	face_right
	delay_16
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	face_up
}