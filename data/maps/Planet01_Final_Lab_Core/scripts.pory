mapscripts Planet01_Final_Lab_Core_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_Final_Lab_Core_Enter
	MAP_SCRIPT_ON_FRAME_TABLE: Planet01_Final_Lab_Core_FrameTable
}

script Planet01_Final_Lab_Core_Enter {
	getplayerxy(VAR_0x8004, VAR_0x8005)
    compare (VAR_0x8004, 0)
    goto_if_ne(OtherEnter, 0)
    compare (VAR_0x8005, 2)
    goto_if_ne(OtherEnter, 0)
	setflashlevel(5)
	setvar(VAR_TEMP_3, 1)

OtherEnter:
	getplayerxy(VAR_0x8004, VAR_0x8005)
    compare (VAR_0x8004, 20)
    goto_if_ne(EndB, 0)
    compare (VAR_0x8005, 24)
    goto_if_ne(EndB, 0)
	setflashlevel(0)
	setvar(VAR_TEMP_4, 1)

EndB:
	end
}

raw `
Planet01_Final_Lab_Core_FrameTable::
	map_script_2 VAR_TEMP_3, 1, Planet01_Final_Lab_Core_BeheeWalk
	map_script_2 VAR_TEMP_4, 1, Planet01_Final_Lab_Core_FinalFight
	.2byte 0
`

script Planet01_Final_Lab_Core_FinalFight{
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Deoxys1)
	waitmovement(0)
	applymovement(1, Movement_Deoxys2)
	waitmovement(0)
	fadeScreen(FADE_TO_BLACK)
	setflag(FLAG_UNUSED_0x054)
	removeobject(1)
	setvar(VAR_0x8000, SPECIES_DEOXYS_NORMAL)
    callnative(RegisterSpeciesInDex)
	trainerbattle_single(TRAINER_WALTER_5, DeoxysBattle_Intro, DeoxysBattle_Outro)
	setflag(FLAG_MAP_SCRIPT_CHECKED_DEOXYS)
	setflag(FLAG_DEOXYS_ROCK_COMPLETE)
	clearflag(FLAG_ENABLE_SHIP_BIRTH_ISLAND)
	warp(MAP_PLANET01_FINAL_LAB_INTERIOR, 2, 15, 1)
    waitstate
	release
	end
}

movement Movement_Deoxys1 {
	delay_16
	delay_16
	walk_up
	walk_up
	walk_up
	face_up
}

movement Movement_Deoxys2 {
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
}

text DeoxysBattle_Intro {
	"Here it comes! Brace yourself!"
}

text DeoxysBattle_Outro {
	"...It's over. The cell dissolves."
}

script Planet01_Final_Lab_Core_BeheeWalk {
	lock
	
	setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
    msgbox("Where am I?")
    waitmessage
	closemessage
    callnative(ClearMugshot)

	msgbox("{COLOR RED}{SHADOW LIGHT_RED}<A Beheeyem... It's tapped into my mind \n"
	"and is showing you my memories...>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage

	waitmessage
	closemessage
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee1)
    waitmovement(0)
	msgbox("{COLOR RED}{SHADOW LIGHT_RED}<This is the Operations Leader and I,\n" 
	"many years ago.\p"
	"When we first met, I was a fresh, young\n"
	"scientist; timid and suffering from \l" 
	"imposter syndrome. Always worried\l" 
	"about proving myself, always seeking\l"
	"validation from others.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee1)
    waitmovement(0)
	msgbox("{COLOR RED}{SHADOW LIGHT_RED}<For a long time, I was jealous of their \n"
	"confidence. Success or failure, they\l"
	"things always seemed to work out for\l"
	"them. But they believed in me too, and\l"
	"as we worked together, their praise and\l"
	"optimism became infectious.\p"
	"As we got closer, they made me begin to\n"
	"believe in myself.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee1)
    waitmovement(0)
	msgbox("{COLOR RED}{SHADOW LIGHT_RED}<We became partners in everything, even\n"
	"work. When we were both assigned to\l" 
	"project EOD, I was overjoyed. The past\l" 
	"few years studying an incredible planet\l"
	"with them and building our research\l"
	"facility together was everything I\l" 
	"could have asked for. I loved them.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage

	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("That's very sweet. Sound like you guys\n"
	"were a power-couple!")
    waitmessage
	closemessage
    callnative(ClearMugshot)

	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee1)
	waitmovement(0)
	
    waitmoncry()
	msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Everything changed after I discovered\n"
	"the Deoxys cell. My experiments were \l"
	"disastrous; it infected me, and \l"
	"triggered Pal 9000's Contingency \l"
	"Protocol, which teleported Ops back to \l"
	"our ship and sent them back home on \l"
	"auto-pilot.\p"
	"All that we had, thrown so easily\n"
	"away, because I got so greedy.\l"
	"...\p"
	"So now you know the truth.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")

	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee2)
    waitmovement(0)
	waitse()
    playmoncry(SPECIES_BEHEEYEM, CRY_MODE_ENCOUNTER)
	setvar(VAR_0x8000, SPECIES_BEHEEYEM)
    callnative(RegisterSpeciesInDex)
	warp(MAP_PLANET01_01, 1, 31, 11)
    waitstate
    release
    end
}

movement Movement_Player_Behee1 {
	face_right
	delay_16
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	face_up
	delay_16
}

movement Movement_Player_Behee2 {
	face_right
	delay_16
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	face_up
}