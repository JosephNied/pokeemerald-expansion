mapscripts Planet01_Final_Lab_Core_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_Final_Lab_Core_Enter
	MAP_SCRIPT_ON_FRAME_TABLE: Planet01_Final_Lab_Core_FrameTable
}

script Planet01_Final_Lab_Core_Enter {
	getplayerxy(VAR_0x8004, VAR_0x8005)
    compare (VAR_0x8004, 0)
    goto_if_ne(EndB, 0)
    compare (VAR_0x8005, 2)
    goto_if_ne(EndB, 0)
	setvar(VAR_TEMP_3, 1)
	setflashlevel(5)

EndB:
	end
}

raw `
Planet01_Final_Lab_Core_FrameTable::
	map_script_2 VAR_TEMP_3, 1, Planet01_Final_Lab_Core_BeheeWalk
	.2byte 0
`

script DoDeoxysBattle{
	trainerbattle_single(TRAINER_WALTER_5, DeoxysBattle_Intro, DeoxysBattle_Outro)
	fadeScreen(FADE_TO_BLACK)
	setflag(FLAG_UNUSED_0x054)
	removeobject(1)
	fadeScreen(FADE_FROM_BLACK)
	setvar(VAR_0x8000, SPECIES_DEOXYS_NORMAL)
    callnative(RegisterSpeciesInDex)
	end
}

text DeoxysBattle_Intro {
	"Here it comes! Brace yourself!"
}

text DeoxysBattle_Outro {
	"...It's over."
}

script Planet01_Final_Lab_Core_BeheeWalk {
	lock
	msgbox("...Where am I?")
	waitmessage
	closemessage
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee1)
    waitmovement(0)
	msgbox("M-my parents?\n"
	"...\p" 
	"I'm getting visions of the times\n" 
	"they would get my siblings and I ready\l"
	"ready for school. Make us dinner. Take\l"
	"care of me when I was sick. On and on...\p"
	"So many memories. They really did love \n"
	"me, huh.\p"
	"I haven't seen them in so long. I know\n"
	"they'd be disappointed if they knew all\l"
	"the choices I've made now. But...\p"
	"Maybe I'm wrong to be so afraid of that.")
	waitmessage
	closemessage
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee1)
    waitmovement(0)
	msgbox("My friends. I'm getting visions of them\n"
	"inviting me to hang out with them,\l"
	"encouraging me, getting me presents,\l"
	"hugging me. They always seemed to \l"
	"express how they feel and who they are\l"
	"so easily.\p"
	"Why couldn't I ever be like that?")
	waitmessage
	closemessage
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee1)
    waitmovement(0)
	msgbox("...Somehow you always know what I need.\n"
	"At my darkest moments, you were there\l" 
	"to lift me up. You told me not to take\l" 
	"this job.\p"
	"You were right again. All my excuses.\n"
	"Was I really just afraid of us getting\l"
	"so close, when I chose to leave?")
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player_Behee2)
    waitmovement(0)
	waitse()
    playmoncry(SPECIES_BEHEEYEM, CRY_MODE_ENCOUNTER)
    waitmoncry()
	msgbox("It'll never be the same. I may\n"
	"never get to say how I feel to any of\l"
	"these people, and it's all my fault. Is\l"
	"that...\p"
	"What you wanted me to learn?")
	setvar(VAR_0x8000, SPECIES_BEHEEYEM)
    callnative(RegisterSpeciesInDex)
	warp(MAP_PLANET01_01, 1, 31, 11)
    waitstate
    release
    end
}

movement Movement_Player_Behee1 {
	face_right
	delay_16
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	face_up
	delay_16
}

movement Movement_Player_Behee2 {
	face_right
	delay_16
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	walk_right
	face_up
}