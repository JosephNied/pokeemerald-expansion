mapscripts Ditto_Cave_2_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Ditto_Cave_2_Enter
}

script Ditto_Cave_2_Enter {
	special(SetRandomFlags)
}

script EventScript_SlugmaCatch {
	lockall
	fadeScreen(FADE_TO_WHITE)
	special(FlashCheck)
	if(var(VAR_RESULT) == 1) {
		setflag(FLAG_TEMP_1)
		removeobject(1)
		fadeScreen(FADE_FROM_WHITE)
		msgbox("Clefable's Flash protected your team\n"
		"from getting burned!")
		setvar(VAR_0x8000, SPECIES_SLUGMA)
		callnative(RegisterSpeciesInDex)
		releaseall
		end
	} else {
		special(SlugmaCatch)
		setflag(FLAG_TEMP_1)
		removeobject(1)
		fadeScreen(FADE_FROM_WHITE)
		msgbox("Slugma burned a party member!\n"
		"Should've run directly away!")
		setvar(VAR_0x8000, SPECIES_SLUGMA)
		callnative(RegisterSpeciesInDex)
		releaseall
		end
	}
}

script slugmanote {
	lock
	msgbox("Ops Lead: This cave just loops around\n"
	"and around... We're totally lost.\p"
	"There's got to be a clue somewhere.\n"
	"There's only one thing I know for sure:\p"
	"If you see a Slugma, run directly away\n"
	"from it!")
	release
	end
}