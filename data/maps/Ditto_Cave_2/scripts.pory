mapscripts Ditto_Cave_2_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Ditto_Cave_2_Enter
}

script Ditto_Cave_2_Enter {
	special(SetRandomFlags)
}

script Ditto_Cave_2_EventScript_Item01 {
    lock
    giveitem(ITEM_STAR_PIECE, 1)
    removeobject(1)
    setflag(FLAG_UNUSED_0x499)
    release
    end
}