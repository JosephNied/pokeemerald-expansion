	setmetatile(11, 10, METATILE_Underwater_darkpuddle_nowarp, FALSE)
	setmetatile(12, 10, METATILE_Underwater_darkpuddle_nowarp, FALSE)
	setmetatile(13, 10, METATILE_Underwater_darkpuddle_nowarp, FALSE)
