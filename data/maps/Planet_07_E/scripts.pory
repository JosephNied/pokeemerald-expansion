mapscripts Planet_07_E_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet_07_E_Enter
	MAP_SCRIPT_ON_LOAD: Planet_07_E_OnLoad
}

script Planet_07_E_Enter {
	special(SetRandomFlags)
	if (var(VAR_DAILY_BLENDER) == 5) {
		setflag(FLAG_TEMP_3)
	}
	end
}

script Planet_07_E_OnLoad {
	call_if_unset(FLAG_TEMP_3, killdarktiles)
	end
}

script gatemessage {
	lockall

	setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
    msgbox("There's some faded text... I've never\n"
	"seen a written language like this, but\l"
	"somehow I feel like I can read it?")
    waitmessage
    callnative(ClearMugshot)

	msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}When five eyes open, so does the gate.\n"
	"There are many trees in the garden\l"
	"beneath the black pool, but only one\l"
	"was designed with that special purpose.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")

	setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
    msgbox("What the? Who would have written this?")
    waitmessage
	closemessage
    callnative(ClearMugshot)

	if ((var(VAR_DAILY_SLOTS) == 0) || (var(VAR_DAILY_SLOTS) == 1))  {
		releaseall
		end
	} elif (var(VAR_DAILY_SLOTS) == 8) {
		setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
		callnative(DrawMugshot)
		msgbox("{COLOR RED}{SHADOW LIGHT_RED}<I'm afraid... I might know.\n"
		"This pool is where I found the Deoxys\l"
		"Cell.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
		waitmessage
		closemessage
		callnative(ClearMugshot)


		setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
		callnative(DrawMugshot)
		msgbox("Huh. But what's with the creepy text?")
		waitmessage
		closemessage
		callnative(ClearMugshot)

		setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
		callnative(DrawMugshot)
		msgbox("{COLOR RED}{SHADOW LIGHT_RED}<After merging with the Deoxys Cell and\n"
		"triggering the Emergency Protocol, my\l"
		"mind unleashed a wave of negative\l" 
		"psychic energy. I think... It manifested\l"
		"something down in that pool.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
		waitmessage
		closemessage
		callnative(ClearMugshot)

		setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
		callnative(DrawMugshot)
		msgbox("Manifested something? Like what?")
		waitmessage
		closemessage
		callnative(ClearMugshot)

		setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
		callnative(DrawMugshot)
		msgbox("{COLOR RED}{SHADOW LIGHT_RED}<A dark entity... I think it has the\n"
		"Shadow Crystal. We need to find a way\l"
		"down there and defeat it.\p"
		"I guess Jirachi is having you clean up\n"
		"my mess. I'm so sorry.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
		waitmessage
		closemessage
		callnative(ClearMugshot)

	} else {
		setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
		callnative(DrawMugshot)
		msgbox("{COLOR RED}{SHADOW LIGHT_RED}<I'm afraid... I might know.\n"
		"This pool is where I found the Deoxys\l"
		"Cell.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
		waitmessage
		closemessage
		callnative(ClearMugshot)


		setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
		callnative(DrawMugshot)
		msgbox("Huh. But what's with the creepy text?")
		waitmessage
		closemessage
		callnative(ClearMugshot)

		setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
		callnative(DrawMugshot)
		msgbox("{COLOR RED}{SHADOW LIGHT_RED}<After merging with the Deoxys Cell and\n"
		"triggering the Emergency Protocol, my\l"
		"mind unleashed a wave of negative\l" 
		"psychic energy. I think... It manifested\l"
		"something down in that pool.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
		waitmessage
		closemessage
		callnative(ClearMugshot)

		setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
		callnative(DrawMugshot)
		msgbox("Manifested something? Like what?")
		waitmessage
		closemessage
		callnative(ClearMugshot)

		setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
		callnative(DrawMugshot)
		msgbox("{COLOR RED}{SHADOW LIGHT_RED}<A dark entity... We should avoid this\n"
		"place. It could be dangerous. Plus the\l"
		"vibe is terrible.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
		waitmessage
		closemessage
		callnative(ClearMugshot)
	}

	releaseall
	end
}

script sableye_07_E {
	lock
	if (flag(FLAG_SYS_PALACE_GOLD) == FALSE) {
		msgbox("Noctowl's eyes open...")
		fadeScreen(FADE_TO_BLACK)
		waitse()
		playmoncry(SPECIES_NOCTOWL, CRY_MODE_ENCOUNTER)
		waitmoncry()
		setflag(FLAG_SYS_PALACE_GOLD)
		removeobject(1)
		addvar(VAR_DAILY_BLENDER, 1)
		if (var(VAR_DAILY_BLENDER) == 5) {
			msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}The gate is open.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
			waitmessage
			closemessage
			warp(MAP_PLANET_07_E, 20, 7, 6)
			waitstate
		} else {
		buffernumberstring(STR_VAR_1, VAR_DAILY_BLENDER)
		msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}{STR_VAR_1} of 5...{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
		}
		fadeScreen(FADE_FROM_BLACK)
		setvar(VAR_0x8000, SPECIES_NOCTOWL)
		callnative(RegisterSpeciesInDex)
	}
	release
	end
}

script killdarktiles {
