mapscripts Ditto_Cave_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Ditto_Cave_Enter
}

script Ditto_Cave_Enter {
    setflashlevel(4)
    if(flag(FLAG_RECEIVED_BELDUM) == FALSE && flag(FLAG_UNUSED_0x03C) == FALSE) {
        setvar(VAR_TEMP_0, 0)
    } else {
        setvar(VAR_TEMP_0, 1)
    }
	special(SetRandomFlags)
}

movement Movement_DittoLeaves {
    face_down
    emote_exclamation_mark
    delay_16
    delay_16
    delay_16
    face_up
    walk_up
    walk_up
    walk_up
}

script Ditto_Test {
    lock
    applymovement(1, Movement_DittoLeaves)
    waitmovement(0)
    removeobject(1)
    setvar(VAR_TEMP_0, 1)
    setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("!!!\l"
    "Who was that?!\p"
    "And why did they look like me?!")
    callnative(ClearMugshot)
    setflag(FLAG_RECEIVED_BELDUM)
    releaseall
}