script JirachiOnShip {
    lock
    faceplayer
    playmoncry(SPECIES_JIRACHI, CRY_MODE_ENCOUNTER)
    setvar(VAR_0x8000, MUGSHOT_JIRACHI_HAPPY)
    callnative(DrawMugshot)
    msgbox("Jirachi wants to join the team!")
    waitmessage
    callnative(ClearMugshot)
    checkitem(ITEM_BEAST_BALL, 1)
    if (var(VAR_RESULT) == TRUE)
    {
        givemon(SPECIES_JIRACHI, 70)
        clearflag(FLAG_REGISTERED_DUSTY)
        removeobject(6)
        removeitem(ITEM_BEAST_BALL, 1)
        release
        end
    } else {
        msgbox("You don't have a spare Meteor Ball!")
        release
        end
    }
}

script IsPlayerReadyToGo {
    if(flag(FLAG_UNUSED_0x027) == true && flag(FLAG_UNUSED_0x028) == true && flag(FLAG_UNUSED_0x029)) {
        setvar(VAR_TEMP_0, 1)
        setvar(VAR_PLAYER_READY, 1)
    } else {
        lockall
        applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down))
        waitmovement(OBJ_EVENT_ID_PLAYER)
        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox("I'm not ready yet!\n"
        "I need Magnezone, and my equipment!\p"
        "I should check the Explorer's Guide too.")
        callnative(ClearMugshot)
        releaseall
    }
    end
}

script EventScript_MapsItem {
    lock

    setvar(VAR_0x8000, MUGSHOT_MAP_01)
    callnative(DrawMugshot)
    msgbox("Map for the Twilight Plateau.\pView the next map?", MSGBOX_YESNO)
    callnative(ClearMugshot)
    if (var(VAR_RESULT) == NO) {
        release
        end
    }

    setvar(VAR_0x8000, MUGSHOT_MAP_02)
    callnative(DrawMugshot)
    msgbox("Map for the Forest.\pView the next map?", MSGBOX_YESNO)
    callnative(ClearMugshot)
    if (var(VAR_RESULT) == NO) {
        release
        end
    }

    setvar(VAR_0x8000, MUGSHOT_MAP_03)
    callnative(DrawMugshot)
    msgbox("Map for the Shoreline.\pView the next map?", MSGBOX_YESNO)
    callnative(ClearMugshot)
    if (var(VAR_RESULT) == NO) {
        release
        end
    }

    setvar(VAR_0x8000, MUGSHOT_MAP_04)
    callnative(DrawMugshot)
    msgbox("Map for the Misty Mountains.")
    callnative(ClearMugshot)
    closemessage

    release
    end
}