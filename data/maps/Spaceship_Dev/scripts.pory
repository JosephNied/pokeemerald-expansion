raw `
Spaceship_Dev_MapScripts::
	.byte 0
`
script Spaceship_Dev_EventScript_BallItem01 {
    lock
    faceplayer
    giveitem(ITEM_MASTER_BALL, 6)
    setflag(FLAG_UNUSED_0x027)
    removeobject(1)
    release
    end
}

script Spaceship_Dev_EventScript_Item01 {
    lock
    faceplayer

    givemon(SPECIES_MAGNEZONE, 50, ITEM_MAGNET)

    if (var(VAR_RESULT) == MON_GIVEN_TO_PARTY) {
        msgbox("Added Magnezone to party.")
		setflag(FLAG_UNUSED_0x028)
		setflag(FLAG_SYS_POKEMON_GET)
		removeobject(2)
    }
	else {
		msgbox("Your party is full!")
	}
	waitmessage
    releaseall
    end
}
