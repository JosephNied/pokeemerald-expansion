script Bellossom {
    lock
    faceplayer
    setvar(VAR_0x8000, MUGSHOT_BELLOSSUM)
    callnative(DrawMugshot)
    playmoncry(SPECIES_BELLOSSOM, CRY_MODE_ENCOUNTER)
    msgbox("Bellossum converts my C02 into oxygen.\n"
    "An important team member!")
    waitmessage
    closemessage
    callnative(ClearMugshot)
    if (flag(FLAG_TEMP_6) == FALSE) {
        setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
        callnative(DrawMugshot)
        playmoncry(SPECIES_BELLOSSOM, CRY_MODE_ENCOUNTER)
        msgbox("Oh? Bellossum has a gift for me!")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        randomelement(ITEM_ADAMANT_MINT,
        ITEM_BOLD_MINT,
        ITEM_BRAVE_MINT,
        ITEM_CALM_MINT,
        ITEM_CAREFUL_MINT,
        ITEM_HASTY_MINT,
        ITEM_IMPISH_MINT,
        ITEM_JOLLY_MINT,
        ITEM_LAX_MINT,
        ITEM_MODEST_MINT,
        ITEM_NAIVE_MINT,
        ITEM_NAUGHTY_MINT,
        ITEM_QUIET_MINT,
        ITEM_RASH_MINT,
        ITEM_RELAXED_MINT,
        ITEM_SASSY_MINT,
        ITEM_SERIOUS_MINT,
        ITEM_TIMID_MINT,
        ITEM_LUM_BERRY,
        ITEM_SITRUS_BERRY)
        giveitem(VAR_RESULT)
        setflag(FLAG_TEMP_6)
    }
    release
    end
}

