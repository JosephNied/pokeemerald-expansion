}

script Spaceship_Dev_EventScript_Tutorial_Notebook {
    lock
    faceplayer
    playse(SE_PC_LOGIN)
    msgbox("Explorer's Guide: What would you like to \n"
    "learn about?")
    multichoice(0, 0, MULTI_TUTORIAL_NOTES, FALSE)
    if (var(VAR_RESULT) == 0) {
        msgbox("Your {COLOR BLUE}{SHADOW LIGHT_BLUE}Oxygen System{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} reports how many\n"
        "units of O2 remain in your portable life \l"
        "support system.\p"
        "You can craft {COLOR BLUE}{SHADOW LIGHT_BLUE}Air Canisters{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} that can\n"
        "refill your Oxygen System at any time.")
        call(Spaceship_Dev_EventScript_Tutorial_Notebook)
    }
    if (var(VAR_RESULT) == 1) {
        msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}Meteor Balls{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} never fail. They can be \n"
        "reused if the Pokemon inside is \l"
        "released.")
        call(Spaceship_Dev_EventScript_Tutorial_Notebook)
    }
    if (var(VAR_RESULT) == 2) {
        msgbox("The {COLOR BLUE}{SHADOW LIGHT_BLUE}Scanner{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} logs useful information\n"
        "about wild Pokemon while allowing you\l"
        "to escape the confrontation unharmed.\p"
        "Faster pokemon are harder to scan.\n"
        "Paralyzing them can make it easier.")
        call(Spaceship_Dev_EventScript_Tutorial_Notebook)
    }
    if (var(VAR_RESULT) == 3) {
        msgbox("The {COLOR BLUE}{SHADOW LIGHT_BLUE}Teleporter{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} can be used to warp\n"
        "back to the ship, and also will \l"
        "automatically trigger in emergency \l"
        "situations.")
        call(Spaceship_Dev_EventScript_Tutorial_Notebook)
    }
    if (var(VAR_RESULT) == 4) {
        msgbox("You can craft {COLOR BLUE}{SHADOW LIGHT_BLUE}Meteor Balls{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} and \n"
        "{COLOR BLUE}{SHADOW LIGHT_BLUE}Air Canisters{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} using the ship's\l"
        "crafting machine, provided you have\l"
        "sufficient Star Pieces and Stardust.")
        call(Spaceship_Dev_EventScript_Tutorial_Notebook)
    }
    setflag(FLAG_UNUSED_0x029)
    playse(SE_PC_OFF)
    release
    end
}

script Spaceship_Dev_EventScript_Item01 {
    lock
    faceplayer
    setflag(FLAG_SYS_POKEDEX_GET)
    setvar(VAR_0x8000, MUGSHOT_MAGNEZONE)
    callnative(DrawMugshot)
    playmoncry(SPECIES_MAGNEZONE, CRY_MODE_ENCOUNTER)
    msgbox("Magnezone, let's go!")
    waitmessage
    callnative(ClearMugshot)
    givemon(SPECIES_MAGNEZONE, 50, ITEM_MAGNET)
    removeobject(5)

    if (var(VAR_RESULT) == MON_GIVEN_TO_PARTY) {
        setflag(FLAG_BADGE01_GET)
        setflag(FLAG_BADGE02_GET)
        setflag(FLAG_BADGE03_GET)
        setflag(FLAG_BADGE04_GET)
        setflag(FLAG_BADGE05_GET)
        setflag(FLAG_BADGE06_GET)
        setflag(FLAG_BADGE07_GET)
        setflag(FLAG_BADGE08_GET)
        msgbox("Added Magnezone to party.")
		setflag(FLAG_UNUSED_0x028)
		setflag(FLAG_SYS_POKEMON_GET)
    }
	else {
		msgbox("Your party is full!")
	}
	waitmessage
    releaseall
    end
}

script Spaceship_Dev_EventScript_ChangePlanet {
    lock
    faceplayer
    msgbox("Where would you like to go?")
    multichoice(0, 0, MULTI_PLANET_SELECT, FALSE)
    if (var(VAR_RESULT) == 0) {
        setvar(VAR_PLANET_DEST, 0)
        msgbox("Traveling to Earth...")
        waitmessage
        closemessage
        fadeScreen(FADE_TO_BLACK)
        delay(40)
        fadeScreen(FADE_FROM_BLACK)
    }
    elif (var(VAR_RESULT) == 1) {
        setvar(VAR_PLANET_DEST, 1)
        msgbox("Traveling to Mars...")
        waitmessage
        closemessage
        fadeScreen(FADE_TO_BLACK)
        delay(40)
        fadeScreen(FADE_FROM_BLACK)
    }
    elif (var(VAR_RESULT) == 2) {
        setvar(VAR_PLANET_DEST, 2)
        msgbox("Traveling to Venus...")
        waitmessage
        closemessage
        fadeScreen(FADE_TO_BLACK)
        delay(40)
        fadeScreen(FADE_FROM_BLACK)
    }
    else {
        msgbox("Travel canceled.")
    }
    release
    end
}

script Spaceship_Dev_EventScript_UpdateWarp {
    lock
    if (var(VAR_PLANET_DEST) == 0)
    {
        msgbox("Downwards to the planet.")
        warp(MAP_PLANET01_01, 0, 18, 11)
        waitstate
    }
    elif (var(VAR_PLANET_DEST) == 1)
    {
        msgbox("Warping to Mars.")
        warp(MAP_ALT_SURFACE_DEV, 0, 13, 9)
        waitstate
    }
    elif (var(VAR_PLANET_DEST) == 2)
    {
        msgbox("Warping to Venus.")
        warp(MAP_METEOR_FALLS_B1F_1R, 3, 17, 3)
        waitstate
    }
    else {
        msgbox("No valid destination set!")
        release
        end
    }
    release
    end
}

script Spaceship_Dev_EventScript_VitaminVendor {
    lock
    faceplayer
    CountItemInBag(ITEM_STARDUST, VAR_STARDUST_COUNT)
    buffernumberstring(STR_VAR_1, VAR_STARDUST_COUNT)
    CountItemInBag(ITEM_STAR_PIECE, VAR_STAR_PIECE_COUNT)
    buffernumberstring(STR_VAR_2, VAR_STAR_PIECE_COUNT)
    playse(SE_PC_LOGIN)
    msgbox("Craft items? Each item requires x1\n"
            " Stardust and x1 Star Pieces.\p"
            "Your Stardust: {COLOR BLUE}{SHADOW LIGHT_BLUE}{STR_VAR_1}\n"
            "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}Your Star Pieces: {COLOR BLUE}{SHADOW LIGHT_BLUE}{STR_VAR_2}")
    waitmessage
    closemessage

    checkitem(ITEM_STARDUST, 1)
    if (var(VAR_RESULT) == FALSE)
    {
        msgbox("You don't have enough material.")
        playse(SE_PC_OFF)
        release
        end
    }
    checkitem(ITEM_STAR_PIECE, 1)
    if (var(VAR_RESULT) == FALSE)
    {
        msgbox("You don't have enough material.")
        playse(SE_PC_OFF)
        release
        end
    }
    else {
        multichoice(0, 0, MULTI_VITAMIN_SELECT, FALSE)
        if (var(VAR_RESULT) == 0)
        {
            if (var(VAR_TOTAL_BALL_COUNT) >= 5) {
                msgbox("You can't carry any more of these.")
                playse(SE_PC_OFF)
                release
                end
            } else {
                removeitem(ITEM_STARDUST, 1)
                removeitem(ITEM_STAR_PIECE, 1)
                giveitem(ITEM_BEAST_BALL, 1)
                addvar(VAR_TOTAL_BALL_COUNT, 1)
                msgbox("Your material has been converted!")
            }
        }
        elif (var(VAR_RESULT) == 1)
        {
            CountItemInBag(ITEM_REPEL, VAR_STARDUST_COUNT) //reusing this variable
            buffernumberstring(STR_VAR_1, VAR_STARDUST_COUNT)
            if (var(VAR_STARDUST_COUNT) >= 2) {
                msgbox("You can't carry any more of these.")
                playse(SE_PC_OFF)
                release
                end
            } else {
                removeitem(ITEM_STARDUST, 1)
                removeitem(ITEM_STAR_PIECE, 1)
                giveitem(ITEM_REPEL, 1)
                msgbox("Your material has been converted!")
            }
        }
        else
        {
            msgbox("Crafting canceled.")
            playse(SE_PC_OFF)
            release
            end
        }
    }
    playse(SE_PC_OFF)
    release
    end
}

script TestRemovePokes {
    lock
    msgbox("Testing releasing party...")
    special(RemoveNativeMonsFromParty)
    release
    end
}

