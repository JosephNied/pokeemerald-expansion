mapscripts MeteorFalls_B1F_1R_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: MeteorFalls_B1F_1R_Enter
}

script MeteorFalls_B1F_1R_Enter {
	special(SetRandomFlags)
	end
}

script MeteorFalls_B1F_1R_EventScript_DittoTrainer {
	trainerbattle_single(TRAINER_MITCHELL, Ditto_Intro, Ditto_Outro)
	msgbox(PostBattle_Ditto, MSGBOX_AUTOCLOSE)
	waitmessage
	end
}

text Ditto_Intro {
	"ditto"
}

text Ditto_Outro {
	"ditto"
}

text PostBattle_Ditto {
	"ditto"
}

script MeteorFalls_B1F_1R_EventScript_RandomItem01 {
    lock
    faceplayer

    random(4)

    if (var(VAR_RESULT) == 0) {
        giveitem(ITEM_MAX_REVIVE, 1)
	}
	elif (var(VAR_RESULT) == 1) {
        giveitem(ITEM_MAX_POTION, 1)
	}
	elif (var(VAR_RESULT) == 2) {
        giveitem(ITEM_LUM_BERRY, 1)
	}
	else {
        giveitem(ITEM_SITRUS_BERRY, 1)
	}
    setflag(FLAG_UNUSED_0x020)
    removeobject(12)
    release
    end
}

