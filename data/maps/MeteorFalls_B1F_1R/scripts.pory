mapscripts MeteorFalls_B1F_1R_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: MeteorFalls_B1F_1R_Enter
}

script MeteorFalls_B1F_1R_Enter {
	special(SetRandomFlags)
	end
}

script MeteorFalls_B1F_1R_MapScripts_UrsalunaEncounter {
    lock

	setflag(FLAG_UNUSED_0x02F)
    setwildbattle(SPECIES_URSALUNA, 60, ITEM_NONE)
	dowildbattle

    release
    end
}