mapscripts Planet01_Final_Lab_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_Final_Lab_Enter
    MAP_SCRIPT_ON_FRAME_TABLE: Planet01_Final_Lab_FrameTable
}

script Planet01_Final_Lab_Enter {
	setvar(VAR_AIR_TIMER_TRIGGERED, 1)
    callnative(StopAirTimer)
    callnative(DisableO2Meter)
	if (flag(FLAG_REGISTERED_LILA_AND_ROY) == FALSE) {
		setvar(VAR_TEMP_0, 0)
	} else {
		setvar(VAR_TEMP_0, 1)
	}
    if (flag(FLAG_MAP_SCRIPT_CHECKED_DEOXYS)) {
		setvar(VAR_TEMP_2, 1)
	}
}

raw `
Planet01_Final_Lab_FrameTable::
	map_script_2 VAR_TEMP_2, 1, Planet01_Final_Lab_FinalWalk
	.2byte 0
`

script Planet01_Final_Lab_FinalWalk {
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_ToFlowers1)
	waitmovement(0)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("Guys! I destroyed the Cell!")
	waitmessage
	closemessage
    callnative(ClearMugshot)

    applymovement(14, moves(face_left))
    applymovement(13, moves(face_left))

    setvar(VAR_0x8000, MUGSHOT_OPS_SMILE)
    callnative(DrawMugshot)
    msgbox("We know! Now, we're back to work.")
	waitmessage
	closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_BIO_HSMILE)
    callnative(DrawMugshot)
    msgbox("First, we need to fix up our lab. Second,\n" 
    "we need to find out how to cure our\l"
    "infected mons.\p" 
    "I have some ideas... But I'll be more\n"
    "careful to do things the right way.")
	waitmessage
	closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("...\p"
	"You guys just don't quit! Think it's\n" 
    "time I leave though.")
	waitmessage
	closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_BIO_HSMILE)
    callnative(DrawMugshot)
    msgbox("Don't be a stranger!\n"
    "This planet is quite beautiful, when\l"
    "nothing is chasing you.\p"
    "Thank you, TARC.")
	waitmessage
	closemessage
    callnative(ClearMugshot)

	delay(30)

    applymovement(14, moves(face_right))
    applymovement(13, moves(face_right))

    delay(30)

	warp(MAP_PLANET01_01, 2, 20, 15)
    waitstate
	release
	end
}

movement Movement_ToFlowers1 {
    walk_down
    walk_right
    walk_right
    walk_right
    delay_16
    delay_16
}

script Final_Lab_Remark01 {
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark, face_left, delay_16))
    waitmovement(OBJ_EVENT_ID_PLAYER)
    setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("Wow! This place is huge!!!\n"
	"How is this even possible?\l"
	"Where is this light coming from? I\l"
	"think I see the lab, in the distance...\p"
	"But I have so many questions!")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
	msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Ops used their Pokémon to create this\n"
	"space...\p"
	"The final fight may be tough; I\n"
	"recommend scouring for some of our old\l"
	"items.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("My instruments say the gravity is\n"
	"higher down here. Also... The air is\l"
	"breathable!")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
	msgbox("{COLOR RED}{SHADOW LIGHT_RED}<And look out for infected mons.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)
	setvar(VAR_TEMP_0, 1)
	setflag(FLAG_REGISTERED_LILA_AND_ROY)
	release
	end
}

script EventScript_CorruptCatch_V {
	lockall
	special(SetBossBattle)
    setwildbattle(
        SPECIES_VENUSAUR,
        65,
        ITEM_NONE
    )
    dowildbattle
    special(BossBattleOff)
	setvar(VAR_0x8000, SPECIES_VENUSAUR)
    callnative(RegisterSpeciesInDex)
	setflag(FLAG_TEMP_4)
	removeobject(1)
	releaseall
	end
}

