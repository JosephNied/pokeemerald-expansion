script EventScript_DragoniteEncounter {
    lockall

    msgbox("A Mega Dragonite! You... aren't\n" 
    "infected?")

    getpartysize
    if (var(VAR_RESULT) >= 6) {
		msgbox("You want to join my team?")
        releaseall
        end
    }

    checkitem(ITEM_BEAST_BALL, 1)
    if (var(VAR_RESULT) == FALSE) {
		msgbox("I'd let you join my team,\n
        if I had an extra Meteor Ball.")
        releaseall
        end
    }


	givemon(SPECIES_DRAGONITE, 50)
    fadeScreen(FADE_TO_BLACK)
    setflag(FLAG_TEMP_9)
    removeobject(4)
    fadeScreen(FADE_FROM_BLACK)

    releaseall
    end
}

