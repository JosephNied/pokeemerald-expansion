mapscripts Planet01_Final_Lab_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_Final_Lab_Enter
}

script Planet01_Final_Lab_Enter {
	setvar(VAR_AIR_TIMER_TRIGGERED, 1)
    callnative(StopAirTimer)
    callnative(DisableO2Meter)
	if (flag(FLAG_REGISTERED_LILA_AND_ROY) == FALSE) {
		setvar(VAR_TEMP_0, 0)
	} else {
		setvar(VAR_TEMP_0, 1)
	}
}

script Final_Lab_Remark01 {
	lock
	applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark, face_left, delay_16))
    waitmovement(OBJ_EVENT_ID_PLAYER)
    setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("WOW!\p"
	"This place is huge!!!\n"
	"How is this even possible?\l"
	"Was this place just like this, or were\l"
	"the scientists involved somehow?\p"
	"Where is this light coming from? I\n"
	"think I see the lab, in the distance...\p"
	"But how did they build it? I have so many\n"
	"questions!")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
	msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}<I will explain everything... \n"
	"When you arrive.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("Alright, I got this...\p"
	"My instruments say the gravity is\n"
	"higher down here. Also... The air\l"
	"is breathable!")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
	msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}<Oh, and look out... For hostiles...>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("Hostiles? What does that mean?!")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
	msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}<Some Pokemon... Aren't fully in control...\n"
	"Of themselves anymore...>\p"
	"<Move slowly, if you have to...>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
	msgbox("Awesome. Vague.")
    waitmessage
    closemessage
    callnative(ClearMugshot)
	setvar(VAR_TEMP_0, 1)
	setflag(FLAG_REGISTERED_LILA_AND_ROY)
	release
	end
}

script EventScript_CorruptCatch_V {
	lockall
	special(SetBossBattle)
    setwildbattle(
        SPECIES_VENUSAUR,
        65,
        ITEM_NONE
    )
    dowildbattle
    special(BossBattleOff)
	setvar(VAR_0x8000, SPECIES_VENUSAUR)
    callnative(RegisterSpeciesInDex)
	setflag(FLAG_TEMP_4)
	removeobject(1)
	releaseall
	end
}

