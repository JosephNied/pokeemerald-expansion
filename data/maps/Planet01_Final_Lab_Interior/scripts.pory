mapscripts Planet01_Final_Lab_Interior_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_Final_Lab_Interior_Enter
	MAP_SCRIPT_ON_FRAME_TABLE: Planet01_Final_Lab_Interior_FrameTable
}

script Planet01_Final_Lab_Interior_Enter {
    setflashlevel(5)

	if (flag(FLAG_REGISTERED_LOLA) == FALSE) {
		setvar(VAR_TEMP_0, 0)
	} else {
		setvar(VAR_TEMP_0, 1)
	}

	if (flag(FLAG_REGISTERED_VALERIE) == FALSE) {
		setvar(VAR_TEMP_1, 0)
	} else {
		setvar(VAR_TEMP_1, 1)
	}

	if (flag(FLAG_MAP_SCRIPT_CHECKED_DEOXYS)) {
		setvar(VAR_TEMP_2, 1)
	}
}

raw `
Planet01_Final_Lab_Interior_FrameTable::
	map_script_2 VAR_TEMP_2, 1, Planet01_Final_Lab_Interior_FinalWalk
	.2byte 0
`

script Planet01_Final_Lab_Interior_FinalWalk {
	lock
	setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
    msgbox("...Hello?\n"
	"...\p"
	"It's over. Where are you?")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_ThroughLab1)
	waitmovement(0)
	setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
	msgbox("Hello?")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	applymovement(OBJ_EVENT_ID_PLAYER, Movement_ThroughLab2)
	waitmovement(0)
	warp(MAP_PLANET01_FINAL_LAB, 1, 7, 42)
    waitstate
	release
	end
}

movement Movement_ThroughLab1 {
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	face_down
}

movement Movement_ThroughLab2 {
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_down
	walk_down
	walk_down
	face_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	walk_left
	face_up
	delay_16
	delay_16
	walk_right
	walk_right
	walk_down
	walk_down
	walk_down
	walk_down
	walk_down
	walk_right
	walk_right
	walk_right
	walk_right
	walk_down
}

script Final_Lab_Interior_Remark01 {
	lock
    setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
    msgbox("Anybody home...?")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
	msgbox("{COLOR RED}{SHADOW LIGHT_RED}<You're here. I can't believe it.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("I'm kinda scared, but I'm coming...")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	setvar(VAR_TEMP_0, 1)
	setflag(FLAG_REGISTERED_LOLA)
	release
	end
}

script Final_Lab_Interior_FlavorText_Trash1 {
    lock
    msgbox("It's a pile of trash.")
    release
    end
}

