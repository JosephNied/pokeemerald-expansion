mapscripts Planet01_Final_Lab_Interior_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_Final_Lab_Interior_Enter
}

script Planet01_Final_Lab_Interior_Enter {
    setflashlevel(5)

	if (flag(FLAG_REGISTERED_LOLA) == FALSE) {
		setvar(VAR_TEMP_0, 0)
	} else {
		setvar(VAR_TEMP_0, 1)
	}

	if (flag(FLAG_REGISTERED_VALERIE) == FALSE) {
		setvar(VAR_TEMP_1, 0)
	} else {
		setvar(VAR_TEMP_1, 1)
	}
}

script Final_Lab_Interior_Remark01 {
	lock
    setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
    msgbox("Anybody home...?")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
	msgbox("{COLOR RED}{SHADOW LIGHT_RED}<You're here. I can't believe it.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)
	setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("I'm kinda scared, but I'm coming...")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	setvar(VAR_TEMP_0, 1)
	setflag(FLAG_REGISTERED_LOLA)
	release
	end
}

script Final_Lab_Interior_FlavorText_Trash1 {
    lock
    msgbox("It's a pile of trash.")
    release
    end
}

script Final_Lab_Interior_FlavorText_Trash2 {
    lock
    msgbox("The doorway is blocked by a pile of\n"
	"trash.")
    release
    end
}

script Final_Lab_Interior_FlavorText_Plant {
    lock
    msgbox("It's a long dead plant.")
    release
    end
}

script Final_Lab_Interior_FlavorText_Books {
    lock
    msgbox("Old textbooks on biology and chemistry.")
    release
    end
}

script Final_Lab_Interior_FlavorText_Board {
    lock
    msgbox("Notes and calendars... Dating back 30\n"
	"years ago?! There are plans and maps for\l"
	"what I can only assume are a rapid\l"
	"terraforming project using Pokemon.")
    release
    end
}

script Final_Lab_Interior_FlavorText_Computer {
    lock
    msgbox("An old computer. It's not running.")
    release
    end
}

script Final_Lab_Interior_FlavorText_CraftingMachine {
    lock
    msgbox("A dusty, old crafting machine. Doesn't\n"
	"seem to work.")
    release
    end
}

script Final_Lab_Interior_FlavorText_Pod {
    lock
    msgbox("Some kind of science machine?")
    release
    end
}

script Final_Lab_Interior_FlavorText_Pokeball {
    lock
    msgbox("A Pokeball!\p"
	"...It's empty.")
    release
    end
}

script Final_Lab_Interior_BiologistEncounter {
	lock

	setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("!!!\n"
	"You-!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Well, here I am. You want to know how \n"
	"I've been helping. You see, Deoxys and\l"
	"I are one. It wants to spread. I do not.\l"
	"Without my concentration, the entire\l"
	"planet would be overrun by now. Don't\l"
	"give me credit, though. This is my fault\l"
	"in the first place, you see.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("...")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}<There isn't much more to say, really. \n"
	"But I do want to confess one thing.\l"
	"I could never let myself be happy. I\l"
	"could never allow myself to be a part of\l"
	"this world, with these people. I could\l"
	"never accept myself. So, I abandoned my\l"
	"team and they abandoned me in turn.\p"
	"Even the memory of me was erased!...\p"
	"Who would I have been if I allowed\n"
	"myself to love others? If I loved\l"
	"myself? These are questions I carry\l"
	"with me to the end, unanswered.\p"
	"You're wondering why I'm telling you\n"
	"this. It's because I've been reading \l"
	"your mind and seeing into your heart.\p"
	"You're much like me. You self-sabotage,\n"
	"like me. You hate yourself, just like \l"
	"me... Please...\p"
	"Don't do what I did and throw it all\n"
	"away.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Very well... Go down into the basement.\n"
	"You'll find the source. Defeat it.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("What will happen to you?")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}<...I wouldn't worry about that. Go.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	
	
	setvar(VAR_TEMP_1, 1)
	setflag(FLAG_REGISTERED_VALERIE)
	release
	end
}