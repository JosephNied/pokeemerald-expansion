script Final_Lab_Interior_BiologistEncounter {
	lock

	setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("!!!\n"
	"You-! I knew you were infected, but-\l"
	"I wasn't prepared to see you like this!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}Well. I don't have much to say now. It\n"
	"was a terrible mistake to experiment on\l"
	"that Deoxys Cell so hastily; I staked\l"
	"my value on my discoveries, but it's\l"
	"clear to me now that I already had \l"
	"everything I needed right here with\l"
	"Ops.\p"
	"I didn't even get to say goodbye...\n"
	"Oh, what would they think of me now?{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
    msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}Personally, I think they'd say that\n"
	"you're pretty brave.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	applymovement(1, moves(emote_question_mark))
	delay(16)

	setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}...What did you say? You sound like-{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("I didn't say anything!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	clearflag(FLAG_TEMP_1B)
	addobject(2)

	applymovement(1, moves(emote_exclamation_mark))
	applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down, emote_question_mark))
	applymovement(2, Ops_moveup1)
	waitmovement(0)

	setvar(VAR_0x8000, MUGSHOT_OPS_SMILE)
    callnative(DrawMugshot)
    msgbox("Hey. Sorry for the delay. Reprogramming\n" 
	"our ship's autopilot to send me back\l" 
	"here with the Emergency Protocol\l" 
	"active was pretty tricky, but I figured\l" 
	"it out.")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}!!!!!!!!{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("Ops?!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	applymovement(2, Ops_moveup2)
	applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
	waitmovement(0)
	applymovement(1, moves(face_right))
	waitmovement(0)

	setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}I... I don't know- What to say!-\n"
	"I didn't think you'd ever make it back!{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	
	setvar(VAR_0x8000, MUGSHOT_OPS_SMILE)
    callnative(DrawMugshot)
    msgbox("Hey, you know you should never\n"
	"underestimate me!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}Of course! Shame on me!\n"
	"...\l"
	"...\p"
	"I'm so happy you're here. But love... I'm\n" 
	"sorry... I don't think I have much time.\p" 
	"You don't need to be a biologist to see\n" 
	"that my body has been destroyed by the\l"  
	"virus. The virus is ironically the only\l" 
	"thing keeping me alive; once you defeat\l"  
	"the Deoxys Cell, I'll...{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("Oh, no.")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_OPS_TEAR1)
    callnative(DrawMugshot)
    msgbox("As the ship was heading home, I cast a\n" 
	"wish out into the starry universe...\p"
	"I may have been disappointed and\n"
	"frustrated by what happened, but that\l" 
	"doesn't change the fact that you are\l" 
	"all I ever wanted.")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	clearflag(FLAG_TEMP_1C)
	addobject(4)
	applymovement(4, Movement_JirachiPlanetLab)
	waitmovement(4)

	setvar(VAR_0x8000, MUGSHOT_JIRACHI_HAPPY)
    callnative(DrawMugshot)
    msgbox("Jirachi!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	applymovement(2, moves(face_down))

	setvar(VAR_0x8000, MUGSHOT_OPS_TEAR2)
    callnative(DrawMugshot)
    msgbox("The universe is full of surprises, eh?\n"
	"Did you forget that Jirachi is the wish\l"
	"Pokémon? I encountered it floating in\l"
	"space while the ship was heading home.\p"
	"I wished for your protection.\n" 
	"Hey, trucker. I wonder if you were part\l"
	"of that wish coming true?\p"
	"Either way, Jirachi seems to be offering\n" 
	"YOU a wish now.\p"
	"Had I known how bad things were, I would\n"
	"have wished to heal them. Is there any\l" 
	"chance that...")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("Say no more, Ops! The name is TARC, by\n" 
	"the way. Nice to meet you.\p"
	"Hey Jirachi, I wish...")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	fadescreen(FADE_TO_WHITE)
	playmoncry(SPECIES_MINIOR, CRY_MODE_ENCOUNTER)
	delay(30)
	delay(30)
	removeobject(1)
	addobject(3)
	applymovement(3, moves(face_down))
	applymovement(1, moves(face_down))
	fadescreen(FADE_FROM_WHITE)

	setvar(VAR_0x8000, MUGSHOT_BIO_HSMILE)
    callnative(DrawMugshot)
    msgbox("I'm... Whole...")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	delay(30)

	applymovement(3, moves(face_right))
	waitmovement(0)

	delay(30)

	setvar(VAR_0x8000, MUGSHOT_BIO_HSMILE)
    callnative(DrawMugshot)
    msgbox("I'm... So happy.\n"
	"Though, as a scientist, I must say that\l"
	"wishes make very little sense!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_OPS_TEAR2)
    callnative(DrawMugshot)
    msgbox("Not everything has to!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	delay(30)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
    msgbox("Hate to mention this now, but things\n" 
	"aren't over yet, are they?")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	applymovement(3, moves(face_down))
	applymovement(2, moves(face_down))
	waitmovement(0)

	setvar(VAR_0x8000, MUGSHOT_BIO_HSMILE)
    callnative(DrawMugshot)
    msgbox("That's right! The Deoxys Cell is still\n" 
	"alive. We need to destroy it!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("Guys, you can leave it to me.\n"
	"I've been preparing for this.")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_BIO_HSMILE)
    callnative(DrawMugshot)
    msgbox("It's in the basement, behind us.\n" 
	"...Thank you, TARC.")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	fadescreen(FADE_TO_BLACK)

	setflag(FLAG_TEMP_1C)
	setflag(FLAG_TEMP_1A)
	setflag(FLAG_TEMP_1B)
	removeobject(4)
	removeobject(3)
	removeobject(2)
	clearflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_RIVAL_BEDROOM)
	addobject(5)
	addobject(6)

	fadescreen(FADE_FROM_BLACK)
	
	setvar(VAR_TEMP_1, 1)
	setflag(FLAG_REGISTERED_VALERIE)
	release
	end
}

movement Ops_moveup1 {
	walk_up
	walk_up
	walk_up
	walk_up
	face_up
}

movement Ops_moveup2 {
	walk_up
	walk_up
	walk_up
	walk_up
	face_left
}

movement Movement_JirachiPlanetLab {
    face_down
    set_visible
    delay_4
    set_invisible
    delay_4
    set_visible
    delay_4
    set_invisible
    delay_4
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
}

script bio1 {
	lock
	faceplayer
	setvar(VAR_0x8000, MUGSHOT_BIO_HSMILE)
    callnative(DrawMugshot)
    msgbox("Thank you, TARC, for your selfless wish.")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	release
	end
}

script op1 {
	lock
	faceplayer
	setvar(VAR_0x8000, MUGSHOT_OPS_SMILE)
    callnative(DrawMugshot)
    msgbox("Kick its ass! I would, but most of my\n"
	"Pokémon are still infected... It was\l"
	"rough getting here.")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	release
	end
}