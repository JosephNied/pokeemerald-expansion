	"...It's empty.")
    release
    end
}

script Final_Lab_Interior_BiologistEncounter {
	lock

	setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("!!!\p"
	"You-! I knew you were infected, but-!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}<In my loneliness and despair, I chose to\n"
	"merge with the cell because I wanted\l"
	"to live, but I didn't want to have a\l"
	"human mind full of abstract worries\l"
	"anymore.\p"
	"I realized too late that I didn't\n"
	"need certainty to find purpose\l"
	"in love...\p"
	"I resisted full assimilation, hoping\n"
	"a team member would rescue me, but\l"
	"they never did. I'm alone; even the \l"
	"memory of me has been erased...{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("But, your team clearly cared about you!\n"
	"Look at all the flowers down here.\l" 
	"I know they were planted for you.")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}<Don't judge me. You're a coward too, \n"
	"running from those who love you \l"
	"because you're too afraid to be \l"
	"responsible for anything.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("...You're right, I ran.")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}<But here... On this planet, you were\n"
	"challenged to confront your weaknesses\l"
	"and you overcame them. And I still don't\l"
	"know... Why I failed to do the same...\p"
	"This is your story. End it here by going\n"
	"home and choosing a real future for\l"
	"yourself. My story, ended in tragedy\l"
	"a long time ago.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("But your story didn't end. You've been\n"
	"fighting for years for this moment.\l" 
	"You've helped me. Tragedies can be good\l"
	"stories too, if bittersweet. You've\l" 
	"proven yourself brave. Now, I can\l"
	"actually rescue you!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}<...I think it's time for you to destroy\n"
	"the cell. It's in the basement behind \l"
	"me.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	
	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("Ok. And then what do I need to do for\n"
	"you?")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}<Don't worry about that now... Just find\n"
	"me when it's over.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	
	setvar(VAR_TEMP_1, 1)
	setflag(FLAG_REGISTERED_VALERIE)
	release
	end
}