    end
}

script Final_Lab_Interior_FlavorText_Pod {
    lock
    msgbox("Some kind of science machine?")
    release
    end
}

script Final_Lab_Interior_FlavorText_Pokeball {
    lock
    msgbox("A Pokéball!\p"
	"...It's empty.")
    release
    end
}

script Final_Lab_Interior_BiologistEncounter {
	lock

	setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("!!!\n"
	"You-! I knew you were infected, but-\l"
	"I wasn't prepared to see you like this!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}Well. I don't have much to say now. It\n"
	"was a terrible mistake to experiment on \l"
	"that Deoxys Cell so hastily; I staked \l"
	"my value on my discoveries, but it's \l"
	"clear to me now that I already had \l"
	"everything I needed right here with\l"
	"Ops.\p"
	"I'm thankful you're here now, to end \n"
	"this.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("It was an accident.")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}Maybe, but who would I have been if I\n"
	"had loved myself enough to understand\l"
	"I didn't need to prove anything to\l"
	"anyone, from the beginning?\p"
	"I just wish Ops was here, now.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("I'm sure Ops still loves you and thinks\p"
	"about you. I bet they'll try to return!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}You have their optimism, you know that?\n"
	"And when you faced your fear, you\l"
	"overcame it.\p"
	"This is your story. Destroy the Cell, go\n"
	"home, and have a wonderful future.\p"
	"That's what I want now. My story ended\n"
	"here in tragedy a long time ago.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("But your story didn't end. You've been\n"
	"fighting for years for this moment,\l" 
	"and you helped me get here. Tragedies\l" 
	"can be good stories too, if\l"
	"bittersweet, but now that I'm here,\l"
	"we can find a way to fix this!")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}...I think it's time for you to destroy\n"
	"the cell. It's in the basement behind \l"
	"me.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	
	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("Ok. And then what do I need to do for\n"
	"you?")
	waitmessage
	closemessage
	callnative(ClearMugshot)

	setvar(VAR_0x8000, MUGSHOT_BIOLOGIST_1)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_BLUE}Don't worry about that now. Just, find\n"
	"me when it's over.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
	waitmessage
	closemessage
	callnative(ClearMugshot)
	
	setvar(VAR_TEMP_1, 1)
	setflag(FLAG_REGISTERED_VALERIE)
	release
	end
}