script Final_Lab_Interior_FlavorText_Board {
    lock
    msgbox("Notes and calendars... Dating back\n"
	"several years ago. There are plans and\l"
	"maps for what appears to be a rapid\l"
	"terraforming project using Pokémon.")
    release
    end
}

