mapscripts Planet01_Diancie_Cave_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_Diancie_Cave_Enter
}

script Planet01_Diancie_Cave_Enter {
	setvar(VAR_TEMP_0, 0)
	end
}

script Planet01_Diancie_Cave_Spawn_Poke {
	lockall
	
	checkitem(ITEM_CHIPPED_POT, 1)
	if (var(VAR_RESULT) == FALSE)
    {
		release
		end
	} 
	else 
	{
		setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    	callnative(DrawMugshot)
		msgbox("Oh?! The Carbink are excited!")
		waitmessage
		closemessage
		callnative(ClearMugshot)
		fadeScreen(FADE_TO_BLACK)

		if (flag(FLAG_UNUSED_0x04B) == TRUE) 
		{
			clearflag(FLAG_UNUSED_0x046)
			addobject(3)
    		removeitem(ITEM_CHIPPED_POT, 1)
			addvar(VAR_CARBINK_COUNT, 1)
		}

		if (flag(FLAG_UNUSED_0x04A) == TRUE) 
		{
			clearflag(FLAG_UNUSED_0x047)
			addobject(4)
    		removeitem(ITEM_CHIPPED_POT, 1)
			addvar(VAR_CARBINK_COUNT, 1)
		}

		if (flag(FLAG_UNUSED_0x04C) == TRUE) 
		{
			clearflag(FLAG_UNUSED_0x048)
			addobject(1)
    		removeitem(ITEM_CHIPPED_POT, 1)
			addvar(VAR_CARBINK_COUNT, 1)
		}

		if (flag(FLAG_UNUSED_0x04D) == TRUE) 
		{
			addobject(2)
			clearflag(FLAG_UNUSED_0x049)
    		removeitem(ITEM_CHIPPED_POT, 1)
			addvar(VAR_CARBINK_COUNT, 1)
		}

		delay(30)

		if (var(VAR_CARBINK_COUNT) < 4) {
			fadeScreen(FADE_FROM_BLACK)
    		msgbox("The Carbink went home!")
		} else {
			setvar(VAR_0x8004, 1)
			setvar(VAR_0x8005, 1)
			setvar(VAR_0x8006, 8)
			setvar(VAR_0x8007, 5)
			special(ShakeCamera)
			clearflag(FLAG_UNUSED_0x045)
			addobject(5)
			fadeScreen(FADE_FROM_BLACK)
			setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    		callnative(DrawMugshot)
    		msgbox("The Carbink- Woah! A Diancie!\n"
			"I think it wants me to approach it...")
			waitmessage
			closemessage
			callnative(ClearMugshot)
		}
	}
	setvar(VAR_TEMP_0, 1)
    releaseall
    end
}

script Planet01_Diancie_Cave_DiancieEncounter {
    lockall
    faceplayer

    msgbox("Diancie seems to appreciate me bringing\n"
	"its children home!\l"
	"It... wants to fight?")
    waitse()
    playmoncry(SPECIES_DIANCIE_MEGA, CRY_MODE_ENCOUNTER)
    waitmoncry()

    special(SetBossBattle)
    setwildbattle(
        SPECIES_DIANCIE_MEGA,
        75,
        ITEM_DIANCITE
    )
    dowildbattle
    special(BossBattleOff)

    compare(VAR_RESULT, FALSE)
    goto_if_eq(PlayerLost_Diancie)

    removeobject(5)
    setflag(FLAG_UNUSED_0x045)

    msgbox("Diancie was pleased with the battle!\n"
    "It left a gift!\p"
	"Some kind of crystal? It looks almost\n"
	"like...!")
	waitmessage
	closemessage

	waitse()
    playmoncry(SPECIES_MAGNEZONE, CRY_MODE_ENCOUNTER)
    waitmoncry()

	setvar(VAR_0x8004, 1)
	setvar(VAR_0x8005, 1)
	setvar(VAR_0x8006, 8)
	setvar(VAR_0x8007, 5)
	special(ShakeCamera)

	special(RemoveMagnezoneForMagnezoneM)
	givemon(SPECIES_ZEKROM, 50, ITEM_MAGNET)

	setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)

	msgbox("Magnezone! You, you-\p"
    "You evolved?!?!?!?!\p"
	"This is incredible! This must be\n"
	"something like Mega Evolution!\p"
	"You always were something special, pal!\n"
	"We definitely wont fail now!")

	waitmessage
	callnative(ClearMugshot)
	closemessage

	setvar(VAR_0x8000, SPECIES_DIANCIE)
    callnative(RegisterSpeciesInDex)
    releaseall
    end

PlayerLost_Diancie:
    releaseall
    end
}