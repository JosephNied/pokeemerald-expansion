mapscripts Planet01_RegiDarkness_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_RegiDarkness_Enter
}

script Planet01_RegiDarkness_Enter {
	if(flag(FLAG_HIDE_VIRIDIAN_FOREST_POTION_2) == FALSE) {
        setvar(VAR_TEMP_0, 0)
	} else {
		setvar(VAR_TEMP_0, 1)
	}
	end
}

script RegiDarkness {
	lock
	if(var(VAR_TEMP_0) == 0) {
		setvar(VAR_TEMP_0, 1)
		msgbox("There's half-eaten fruit lying at the\n"
		"base of the tree...\p"
		"Isn't it strange, that this place\n"
		"exists?\p"
		"That any place exists?\p"
		"We must be here for a reason,\n"
		"There must be something I'm supposed\l"
		"to do.\p"
		"Oh, God... What am I supposed to do...?")
		    waitse()
    	playmoncry(SPECIES_REGISTEEL, CRY_MODE_ENCOUNTER)
    	waitmoncry()
		special(SetBossBattle)
		setwildbattle(
			SPECIES_REGISTEEL,
			80,
			ITEM_NONE
		)
		dowildbattle
		special(BossBattleOff)
		setvar(VAR_0x8000, SPECIES_REGISTEEL)
    	callnative(RegisterSpeciesInDex)
		giveitem(ITEM_COMET_SHARD, 1)

		msgbox("I still don't know what's going on.\n"
		"...I think that's ok. I don't think I'm\l" 
		"expected to.\p"
		"It's time to get out of here. I really \n"
		"want to get home.")
		warp(MAP_SPACESHIP_DEV, 0, 12, 7) 
		waitstate
		release
		end
	} else {
	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
	msgbox("I still don't know what's going on.\n"
	"...I think that's ok. I don't think I'm\l" 
	"expected to.\p"
	"It's time to get out of here. I really \n"
	"want to get home.")
	waitmessage
    closemessage
    callnative(ClearMugshot)
	warp(MAP_SPACESHIP_DEV, 0, 12, 7) 
	waitstate
	release
	end
	}
}