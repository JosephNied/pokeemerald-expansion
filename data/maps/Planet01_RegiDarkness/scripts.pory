mapscripts Planet01_RegiDarkness_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_RegiDarkness_Enter
}

script Planet01_RegiDarkness_Enter {
	if(flag(FLAG_HIDE_VIRIDIAN_FOREST_POTION_2) == FALSE) {
        setvar(VAR_TEMP_0, 0)
	} else {
		setvar(VAR_TEMP_0, 1)
	}
	end
}

script RegiDarkness {
	lock
	if(var(VAR_TEMP_0) == 0) {
		setvar(VAR_TEMP_0, 1)
		msgbox("There's half-eaten fruit lying at the\n"
		"base of the tree.\p"
		"{COLOR RED}{SHADOW LIGHT_RED}A strange feeling is coming over me...{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
		waitse()
    	playmoncry(SPECIES_REGISTEEL, CRY_MODE_ENCOUNTER)
    	waitmoncry()
		special(SetBossBattle)
		setwildbattle(
			SPECIES_REGISTEEL,
			80,
			ITEM_NONE
		)
		special(StartRegiBattle)
		special(BossBattleOff)
		setvar(VAR_0x8000, SPECIES_REGISTEEL)
    	callnative(RegisterSpeciesInDex)
		giveitem(ITEM_COMET_SHARD, 1)

		msgbox("The dark force has been defeated.\n"
		"Let's get out of here!")
		warp(MAP_SPACESHIP_DEV, 0, 12, 7) 
		waitstate
		release
		end
	} else {
	setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
	msgbox("The dark force has been defeated.\n"
	"Let's get out of here!")
	waitmessage
    closemessage
    callnative(ClearMugshot)
	warp(MAP_SPACESHIP_DEV, 0, 12, 7) 
	waitstate
	release
	end
	}
}