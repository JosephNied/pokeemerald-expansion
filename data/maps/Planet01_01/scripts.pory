mapscripts Planet01_01_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_01_Enter
    MAP_SCRIPT_ON_FRAME_TABLE: Planet01_01_FrameTable
}

script Planet01_01_Enter {
	special(SetRandomFlags)
    setvar(VAR_AIR_TIMER_STEPS, 100)
    setvar(VAR_AIR_TIMER_TRIGGERED, 1)
	end
}

raw `
Planet01_01_FrameTable::
	map_script_2 VAR_AIR_TIMER_TRIGGERED, 1, Planet01_01_StartAirTimer
	.2byte 0
`

script Planet01_01_StartAirTimer {
    setvar(VAR_AIR_TIMER_TRIGGERED, 0)
    special(StartAirTimerMap)
    lockall
    msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}Low Oxygen detected. Supplying air.")
    releaseall
    end
}

script Planet01_01_HintText01 {
    lock
    msgbox("Some text says a thing!")
    release
    end
}

script Planet01_01_EventScript_Item01 {
    lock
    giveitem(ITEM_REPEL, 2)
    removeobject(12)
    release
    end
}

script Planet01_01_AirExpired {
    lockall
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}Oxygen depleted. Teleporting back...")
    warp(MAP_SPACESHIP_DEV, 0, 12, 7)
    waitstate
    releaseall
    end
}

script Planet01_01_AddAir_Minior01 {
    lockall
    setvar(VAR_AIR_TIMER_STEPS, 75)
    special(AddAirTimerMap)
    msgbox("Minior is floating in a pocket of air! {COLOR BLUE}{SHADOW LIGHT_BLUE}Oxygen added!")
    releaseall
    setflag(FLAG_UNUSED_0x032)
    end
}

script Planet01_01_AddAir_Minior02 {
    lockall
    setvar(VAR_AIR_TIMER_STEPS, 75)
    special(AddAirTimerMap)
    msgbox("Minior is floating in a pocket of air! {COLOR BLUE}{SHADOW LIGHT_BLUE}Oxygen added!")
    releaseall
    setflag(FLAG_UNUSED_0x02B)
    end
}