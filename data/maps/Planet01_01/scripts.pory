    face_up
    set_visible
    jump_up
}

movement Movement_Deoxo2_1 {
    face_up
    set_visible
    jump_up
}

movement Movement_Deoxo1_12 {
    walk_up
    walk_up
    face_right
}

movement Movement_Deoxo2_12 {
    walk_up
    walk_up
    face_left
}

movement Movement_Deoxo1_2 {
    walk_right
}

movement Movement_Deoxo2_2 {
    walk_left
}

movement Movement_Deoxo1_3 {
    jump_left
    set_invisible
}

movement Movement_Deoxo2_3 {
    jump_right
    set_invisible
}

movement Movement_Jirachi1 {
    face_down
    set_visible
    delay_4
    set_invisible
    delay_4
    set_visible
    delay_4
    set_invisible
    delay_4
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
}

movement Movement_Jirachi2 {
    face_up
    delay_16
    walk_up
    walk_up
    walk_up
    walk_up
}

script EventScript_TheCaptain {
    lock

    if (var(VAR_CAPTAIN_DIALOGUE) == 0) 
    {
        setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
        callnative(DrawMugshot)
        msgbox ("Did you see those monsters? I almost\n"
        "died! You didn't warn me about those!")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox ("Ah, yeah, those guys.\n"
        "They neverrr botherrred me before.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("...Sure. But what are they?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox ("I have memorrries of our team, when\n"
        "we firrrst arrrived. These things werrre\l"
        "not herrre.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
        callnative(DrawMugshot)
        msgbox ("How long ago was the expedition?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("Memorrry gap ends a while back...\n"
        "I'd estimate five yearrrs? But I don't\l"
        "know how long we werrre herrre, or\l"
        "how long ago we arrrived.")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        setvar(VAR_CAPTAIN_DIALOGUE, 4)
    }
    elif (var(VAR_CAPTAIN_DIALOGUE) == 1) 
    {
        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("Your map is great, but I'm a bit\n"
        "confused. Where are we now?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("The Twilight Plateau.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("Ok, and your lab was is in the\n"
        "forest somewhere?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("Up the waterrrfall, yep.")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        setvar(VAR_CAPTAIN_DIALOGUE, 2)
    }
    elif (var(VAR_CAPTAIN_DIALOGUE) == 2) 
    {
        setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
        callnative(DrawMugshot)
        msgbox ("So, were you a part of this team of\n"
        "researchers? Are you sure you were the\l"
        "captain?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("Of courrrse! Have you seen my hat?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("...I don't know if that's especially\n"
        "great evidence.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("Don't take this from me, kiddo.")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        setvar (VAR_CAPTAIN_DIALOGUE, 1)
    }
    elif (var(VAR_CAPTAIN_DIALOGUE) == 3) 
    {
        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("Hey Cap', I can't get up the waterfall.\n"
        "What do I do now?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("There's gotta be a pokerrrmon with\n"
        "waterrrfall somewhere, kiddo. Don't give\l"
        "up.")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        setvar (VAR_CAPTAIN_DIALOGUE, 3)
    }
    elif (var(VAR_CAPTAIN_DIALOGUE) == 4) 
    {
        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("I want to ask some questions about the\n"
        "previous explorers.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("Firrre away.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        multichoice(0, 0, MULTI_EXPLORERS_FACTS, FALSE)
        if (var(VAR_RESULT) == 0) {
            msgbox("Me? State-of-the-art Captobot by\n"
            "BOTech Enterprrrises. I was the latest\l" 
            "model when we set out into space.\l" 
            "Designed to keep up morrrale, maintain\l" 
            "focus on our objectives, and give full,\l" 
            "detailed rrreporrrts on all of our\l" 
            "activities.")
        } elif (var(VAR_RESULT) == 1) {
            msgbox("Expert in rrresearching alien PKMN.\n"
            "Quiet.\l"
            "Didn't like to be the centerrr of\l" 
            "attention, and often would get lost\l" 
            "wanderrring off on their own. Made\l" 
            "excellent notes on this rrregion's\l" 
            "biological life.")
        } elif (var(VAR_RESULT) == 2) {
            msgbox("A genius with an interrrest in building\n"
            "structurrres in challenging locations.\l" 
            "Had their eyes on transforming hostile\l" 
            "environments into life-sustaining ones\l" 
            "forrr humans.")
        } elif (var(VAR_RESULT) == 3) {
            msgbox("PKMN experrrt and project organizerrr.\n"
            "Always ready to help, and easy to talk\l" 
            "to about anything. Optimistic, harrrd\l" 
            "worker. Some records suggest they had \l" 
            "a history with the Biologist, but that's\l"
            "just my intuition.")
        }
    }
    release
    end
}
