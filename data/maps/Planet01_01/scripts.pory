mapscripts Planet01_01_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_01_Enter
    MAP_SCRIPT_ON_FRAME_TABLE: Planet01_01_FrameTable
}

script Planet01_01_Enter {
	special(SetRandomFlags)
    special(BossBattleOff)
    setvar(VAR_TEMP_0, 5)
    getplayerxy(VAR_0x8004, VAR_0x8005)
    compare (VAR_0x8004, 18)
    goto_if_ne(End, 0)
    compare (VAR_0x8005, 10)
    goto_if_ne(End, 0)

    setvar(VAR_AIR_TIMER_STEPS, 250)
    setvar(VAR_AIR_TIMER_TRIGGERED, 1)
    if(flag(FLAG_REGISTERED_ROSE) == FALSE) {
        setvar(VAR_TEMP_0, 0)
    } else {
        if(flag(FLAG_REGISTERED_CRISTIN) == FALSE) {
        setvar(VAR_TEMP_0, 2)
        } else {
            setvar(VAR_TEMP_0, 1)
        }
    }

End:
	end
}

raw `
Planet01_01_FrameTable::
	map_script_2 VAR_AIR_TIMER_TRIGGERED, 1, Planet01_01_StartAirTimer
    map_script_2 VAR_TEMP_0, 0, Planet01_01_RobotGreeting
    map_script_2 VAR_TEMP_0, 2, Planet01_01_JirachiAppears
	.2byte 0
`

script Planet01_01_StartAirTimer {
    setvar(VAR_AIR_TIMER_TRIGGERED, 0)
    special(StartAirTimerMap)
    lockall
    playse(SE_REPEL)
    msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}Low Oxygen detected. Supplying air.")
    callnative(EnableO2Meter)
    releaseall
    end
}

script Planet01_01_EventScript_Item01 {
    lock
    giveitem(ITEM_STARDUST, 1)
    removeobject(12)
    setflag(FLAG_UNUSED_0x493)
    release
    end
}

script Planet01_01_EventScript_Item02 {
    lock
    giveitem(ITEM_STAR_PIECE, 1)
    setflag(FLAG_UNUSED_0x494)
    removeobject(11)
    release
    end
}

script Planet01_01_EventScript_Item03 {
    lock
    giveitem(ITEM_COMET_SHARD, 1)
    setflag(FLAG_UNUSED_0x4A8)
    removeobject(18)
    release
    end
}

script Planet01_01_AirWarning {
    lockall
    msgbox("Warning: Oxygen low.")
    releaseall
    end
}

script Planet01_01_AirExpired {
    lockall
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}Oxygen depleted. Teleporting back...")
    warp(MAP_SPACESHIP_DEV, 0, 12, 7)
    waitstate
    releaseall
    end
}

script Planet01_01_AddAir_Minior01 {
    lockall
    setvar(VAR_AIR_TIMER_STEPS, 250)
    special(AddAirTimerMap)
    playmoncry(SPECIES_MINIOR, CRY_MODE_ENCOUNTER)
    msgbox("Minior is floating in a pocket of air!\n"
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Oxygen captured!")
    setflag(FLAG_TEMP_1)
    fadeScreen(FADE_TO_BLACK)
    removeobject(9)
    callnative(RefreshO2Meter)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("Minior flew away...")
    setvar(VAR_0x8000, SPECIES_MINIOR)
    callnative(RegisterSpeciesInDex)
    releaseall
    end
}

script Planet01_01_AddAir_Minior02 {
    lockall
    setvar(VAR_AIR_TIMER_STEPS, 250)
    special(AddAirTimerMap)
    playmoncry(SPECIES_MINIOR, CRY_MODE_ENCOUNTER)
    msgbox("Minior is floating in a pocket of air!\n"
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Oxygen captured!")
    setflag(FLAG_UNUSED_0x02B)
    fadeScreen(FADE_TO_BLACK)
    removeobject(2)
    callnative(RefreshO2Meter)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("Minior flew away...")
    setvar(VAR_0x8000, SPECIES_MINIOR)
    callnative(RegisterSpeciesInDex)
    releaseall
    end
}

script Planet01_01_HintText01 {
    lock
    msgbox("Captain: This is the captain of\n" 
    "expedition 001. \p"
    "Our team has placed notes for future \n"
    "explorers in hopefully convenient \l"
    "places. Our objective is to create\l"
    "a lab here for biological research.\p"
    "Note: The gravity is low here. Tall \n"
    "ledges can be scaled easily!")
    release
    end
}

script Planet01_01_HintText02 {
    lock
    msgbox("Biologist: The plants emit oxygen when\n"
    "stepped on. Our Oxygen Systems can\l"
    "capture it, preventing our O2 levels\l"
    "from lowering while we're on the grass!")
    release
    end
}

script Planet01_01_HintText03 {
    lock
    msgbox("Engineer: The Steelix here have been\n"
    "digging deep into the planet's core;\l"
    "this blue liquid they've been exposed\l"
    "to has changed their type and color...\p"
    "I'll collect some samples...")
    release
    end
}

script Planet01_01_HintText04 {
    lock
    msgbox("Biologist: Miniors are flying types,\n"
    "the air they generate can be captured\l"
    "and used to refill the oxygen in our \l"
    "life support systems. Handy!")
    release
    end
}

script Planet01_01_HintText05 {
    lock
    msgbox("Biologist: There are a lot of\n"
    "members of the Clefairy family around\l"
    "these rocks. They must prefer to live\l"
    "in the mountains.")
    release
    end
}

script Planet01_01_Carbink {
    lock
    faceplayer
    playmoncry(SPECIES_CARBINK, CRY_MODE_ENCOUNTER)
    setvar(VAR_0x8000, SPECIES_CARBINK)
    callnative(RegisterSpeciesInDex)
    msgbox("The Carbink seems to want to play!")
    setflag(FLAG_UNUSED_0x04B)
    fadeScreen(FADE_TO_BLACK)
    removeobject(1)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}Carbink climbed into your bag!")
    giveitem(ITEM_CHIPPED_POT, 1)
    release
    end
}

script Planet01_01_Elgyem {
    lock
    faceplayer
    playmoncry(SPECIES_ELGYEM, CRY_MODE_ENCOUNTER)
    setvar(VAR_0x8000, SPECIES_ELGYEM)
    callnative(RegisterSpeciesInDex)
    msgbox("Elgyem seems taken off-guard!\n"
    "My bad- Huh?! It's flashing red-")
    waitmessage
    warp(MAP_PLANET01_04, 1, 12, 1)
    waitstate
    release
    end
}

script Planet01_01_RobotGreeting {
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player0)
    waitmovement(0)
    special(Script_FadeOutMapMusic)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_question_mark, face_up))
    waitmovement(OBJ_EVENT_ID_PLAYER)
    setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
    msgbox("...I see can't anything wrong with my\n"
    "ship.\p"
    "No hull damage, fuel is good. What-")
    waitmessage
    closemessage
    callnative(ClearMugshot)
    setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
    msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}Hey!\n"
    "Down herrre, pal!{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark, face_down))
    waitmovement(OBJ_EVENT_ID_PLAYER)
    setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("What was that? A person?!")
    waitmessage
    closemessage
    callnative(ClearMugshot)
    delay(30)
    setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
    msgbox("...Hello? How do I get down?")
    waitmessage
    closemessage
    callnative(ClearMugshot)
    setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
    msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}Just jump, it's safe!{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player1)
    waitmovement(0)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox("Hello, frrreind.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
    msgbox("Uh, hello. Who are you?")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox("Why, I'm the captain of the \n" 
    "experrrdition LYDIAN. Yep, I'm the\l" 
    "captain. Never let a human do something\l" 
    "important, that's my motto. It was also\l"
    "my company's slogan.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("...Really. Uh, if that's so, is your\n"
    "human crew somewhere around here?")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox("Noooope. They'rrrre long gone, kiddo.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
    msgbox("...Oh. Where'd they go?")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox("I don't know. I don't really know much\n" 
    "to be honest, on account of my memories\l" 
    "missing; orrr, perrrhaps errrased.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("...Ok. Well, any chance you know why I\n"
    "can't lift my ship off the ground?")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox("Well sirrr/ma'am/sirrr'am, it's all\n" 
    "account of the absurd levels of purrrre\l" 
    "psychic energy layerrred on top of it.\l"
    "Yep.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("...WHAT? So you're saying something is\n"
    "trapping me here?!")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox("I suppose. Sorrry kiddo.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("...Well this is unsettling. I have more\n"
    "questions. A lot more questions.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox("Well kiddo, you'rrre in luck. See these\n"
    "here wall scribbles?")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_question_mark, face_up))
    waitmovement(OBJ_EVENT_ID_PLAYER)
    
    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox("My team was kind enough to leave\n"
    "some notes for futurre explorrrerrrs.\p"
    "In fact, I've been rrreading them too.\n" 
    "I've learrrned that our primary\l"
    "rrresearrrch facility was up the\l"
    "waterrrfall in the forrrest just\l"
    "overrr to the west.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark, face_left))
    waitmovement(OBJ_EVENT_ID_PLAYER)
    delay(60)

    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
    waitmovement(OBJ_EVENT_ID_PLAYER)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("Oh? That sounds like a promising place\n"
    "to investigate. Do you have, like a map?")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox ("Yes in fact I do! Let me load it up for\n"
    "you!")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(17, moves(face_up))
    waitmovement(OBJ_EVENT_ID_PLAYER)

    delay(60)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox ("<Its... drawing something? Where\n"
    "did it get that paper and pencil?>")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    delay(60)

    applymovement(17, moves(face_down))
    waitmovement(OBJ_EVENT_ID_PLAYER)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox ("Here you arrre!\n"
    "Our old lab is to the left.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    giveitem(ITEM_WAILMER_PAIL)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox ("Awesome, a map!\n"
    "...\l"
    "...You're quite the artist!")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox("Thank you, kiddo.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("I'm like, almost 30.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox("Well happy early birthday, kiddo.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("...")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("Guess I'll start reading these notes!")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    waitmovement(OBJ_EVENT_ID_PLAYER)

    delay(30)

    special(Overworld_PlaySpecialMapMusic)
    setvar(VAR_TEMP_0, 1)
    setflag(FLAG_REGISTERED_ROSE)

    msgbox("Captain: This is the captain of\n" 
    "expedition 001. \p"
    "Our team has placed notes for future \n"
    "explorers in hopefully convenient \l"
    "places. Our objective is to create\l"
    "a lab here for biological research.\p"
    "Note: The gravity is low here. Tall \n"
    "ledges can be scaled easily!")
    setflag(FLAG_TEMP_9)
    setvar(VAR_CAPTAIN_DIALOGUE, 1)
    release
    end
    }

movement Movement_Player0 {
    walk_left
    face_up
    delay_16
    delay_16
    delay_16
    walk_right
    walk_right
    walk_right
    walk_right
    face_up
    delay_16
    delay_16
    delay_16
    walk_left
    walk_left
    walk_left
    face_up
}

movement Movement_Player1 {
    delay_16
    delay_16
    face_right
    walk_right
    walk_right
    delay_8
    walk_down
    delay_16
    delay_16
    walk_down
    delay_16
    delay_16
    delay_16
    jump_down
    jump_down
    face_right
}

script Planet01_01_JirachiAppears {
    lockall
    special(Script_FadeOutMapMusic)

    applymovement(19, Movement_Deoxo1_1)
    applymovement(20, Movement_Deoxo2_1)
    waitmovement(0)

    delay(30)

    applymovement(OBJ_EVENT_ID_PLAYER, Movement_Player2)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    
    delay(30)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("Uh oh.\n"
    "I really don't like this.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Hey, you. See these monsters? They're\n" 
    "corrupted by a powerful space virus.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(19, Movement_Deoxo1_12)
    applymovement(20, Movement_Deoxo2_12)
    waitmovement(0)

    setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}They will never stop pursuing you. They\n" 
    "want to infect you and steal your ship.\l" 
    "Your team... Magnezone... Hm. I guess\l" 
    "this is the end.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("Who are you?\n"
    "What do you mean by that?!")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(19, Movement_Deoxo1_2)
    applymovement(20, Movement_Deoxo2_2)
    waitmovement(0)

    delay(30)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("H-HELP!")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    fadescreen(FADE_TO_WHITE)
	closemessage
	delay(30)
	fadescreen(FADE_FROM_WHITE)

    applymovement(14, Movement_Jirachi1)
    waitmovement(0)
    
    fadescreen(FADE_TO_WHITE)
	closemessage
	delay(10)
	fadescreen(FADE_FROM_WHITE)
    setvar(VAR_0x8004, 1)
	setvar(VAR_0x8005, 1)
	setvar(VAR_0x8006, 8)
	setvar(VAR_0x8007, 5)
	special(ShakeCamera)
    applymovement(19, Movement_Deoxo1_3)
    applymovement(20, Movement_Deoxo2_3)
    fadescreen(FADE_TO_WHITE)
	closemessage
	delay(10)
	fadescreen(FADE_FROM_WHITE)
    waitmovement(0)

    delay(60)

    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    waitmovement(OBJ_EVENT_ID_PLAYER)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("...Jirachi?")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_JIRACHI_WORRIED)
    callnative(DrawMugshot)
    msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}...{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(14, Movement_Jirachi2)
    waitmovement(0)

    setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
    callnative(DrawMugshot)
    msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Oh, wow. Lucky. Very lucky...>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_question_mark, face_down))
    waitmovement(OBJ_EVENT_ID_PLAYER)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("Who the hell are you? I demand you tell\n"
    "me! Hello?\l"
    "...Hello?!\p"
    "...")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("Great. Amnesiac robots, space viruses,\n" 
    "and psychic assholes. All in the middle\l"
    "of nowhere. Serves me right, in a way.")
    waitmessage
    closemessage
    callnative(ClearMugshot)


    setflag(FLAG_REGISTERED_CRISTIN)
    setvar(VAR_TEMP_0, 1)
    setvar(VAR_CAPTAIN_DIALOGUE, 0)
    release
    end
}

movement Movement_Player2 {
    emote_question_mark
    face_right
    delay_16
    delay_16
    emote_exclamation_mark
    face_left
    delay_16
    delay_16
    face_down
}

