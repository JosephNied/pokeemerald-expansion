    face_down
    set_visible
    delay_4
    set_invisible
    delay_4
    set_visible
    delay_4
    set_invisible
    delay_4
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
}

movement Movement_Jirachi2 {
    face_up
    delay_16
    walk_up
    walk_up
    walk_up
    walk_up
}

script EventScript_TheCaptain {
    lock

    if (var(VAR_CAPTAIN_DIALOGUE) == 0) 
    {
        setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
        callnative(DrawMugshot)
        msgbox ("Did you see those monsters? I almost\n"
        "died! You didn't warn me about those!")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox ("Ah, yes, those guys.\n"
        "They never bothered me before.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("I can guess why. But what are they?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox ("They aren't present in the memories I\n"
        "have pre-encryption.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
        callnative(DrawMugshot)
        msgbox ("That's awfully suspicious. Anything\n"
        "else I should know?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("...The owls are not what they\n"
        "seem.")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        setvar(VAR_CAPTAIN_DIALOGUE, 4)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("C'mon, man.")
        waitmessage
        closemessage
        callnative(ClearMugshot)
    }
    elif (var(VAR_CAPTAIN_DIALOGUE) == 1) 
    {
        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("Your map is... great, but I'm a bit\n"
        "confused. Where are we now?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("The Twilight Plateau.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("And your lab was in the forest?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("Up the waterfall, yep.")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        setvar(VAR_CAPTAIN_DIALOGUE, 2)
    }
    elif (var(VAR_CAPTAIN_DIALOGUE) == 2) 
    {
        setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
        callnative(DrawMugshot)
        msgbox ("So, you were a part of this team of\n"
        "researchers? Are you sure you were the\l"
        "captain?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("Of course! Have you seen my hat?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("...I don't know if that's especially\n"
        "great evidence.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("Don't take this from me, kiddo.")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        setvar (VAR_CAPTAIN_DIALOGUE, 1)
    }
    elif (var(VAR_CAPTAIN_DIALOGUE) == 3) 
    {
        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("Hey Cap', I can't get up the waterfall.\n"
        "What do I do now?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("There's gotta be a pocket mon with\n"
        "Waterfall somewhere, kiddo. Don't give\l"
        "up.")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        setvar (VAR_CAPTAIN_DIALOGUE, 3)
    }
    elif (var(VAR_CAPTAIN_DIALOGUE) == 4) 
    {
        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox ("I want to ask some questions about the\n"
        "EDGE OF DAWN team.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
        callnative(DrawMugshot)
        msgbox("Fire away.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        multichoice(0, 0, MULTI_EXPLORERS_FACTS, FALSE)
        if (var(VAR_RESULT) == 0) {
            msgbox("Me? State-of-the-art PAL 9000.\n"
            "I was the latest model when we set out\l" 
            "seven years ago.\p" 
            "Designed to keep up morale, maintain\n" 
            "focus on our objectives, and give full,\l" 
            "detailed reports on all of our\l" 
            "activities. I'm dissapointed whatever\l"
            "situation we ran into required my\l" 
            "team to leave without me, but I'm sure\l"
            "they had good reason to do so.")
        } elif (var(VAR_RESULT) == 1) {
            msgbox("Expert in researching alien Pokémon\n"
            "anatomy and abilities. Made some pretty\l" 
            "amazing discoveries, but insisted their\l" 
            "big breakthrough was yet to come.")
        } elif (var(VAR_RESULT) == 2) {
            msgbox("Expert Pokémon trainer and\n"
            "coordinator. Could direct Pokémon to\l" 
            "build any structure, no matter how\l" 
            "challenging the environment.\p"
            "Optimistic, hard working. Would do\n" 
            "anything to support the team.")
        }
    }
    release
    end
}

script Planet01_01_MonstersRegular {
    lockall
    setvar(VAR_DAILY_SLOTS, 4)
    call(voicedialogueABC)
    clearflag(FLAG_REGISTERED_BROOKE)
    setvar(VAR_TEMP_0, 1)
    releaseall
    end
}

script Planet01_01_Ending {
    lockall
    callnative(ClearMugshot)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_question_mark, face_right))
    waitmovement(OBJ_EVENT_ID_PLAYER)
    setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox ("Hey Cap', how are the psychic readings\n"
    "on the ship?")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox("Readings negative, kiddo. Should be\n"
    "free for take off anytime.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox ("...\n"
    "I've been thinking.\p"
    "How would you like to join my crew?")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_CAPTAIN_SAD)
    callnative(DrawMugshot)
    msgbox("Kiddo. Are you... Perhaps, being serious?\n"
    "Why, that would fill my most definitely\l"
    "real robot soul with joy. Can I be your\l"
    "Captain?")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox ("Maybe. I think I need a break for a bit.\n"
    "We'll start by cleaning that rust off of\l"
    "you. Let's go!")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_down))
    waitmovement(OBJ_EVENT_ID_PLAYER)

    delay(30)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("Goodbye!")
    waitmessage
    closemessage
    callnative(ClearMugshot)
    fadescreenspeed(FADE_TO_BLACK, 8)
    msgbox("Thanks for playing!\n"
    "Credits:\p"
    "Developers:\n"
    "dBlue: Coding, graphics, maps, music\l"
    "Grrrita: Character art, title screen, concepts\l"
    "Kittycatsaton: Story advice\l"
    "<><><><>\p"
    "Playtesters: MyNameIsJeff, MayaZ\n"
    "<><><><>\p"
    "Additional credits:\n"
    "Montblanc: SWSH Party and Summary base and assistance\l"
    "<><><><>\p"
    "Chunsoft, Emmuffin, and G: Pokémon Mugshots\n"
    "<><><><>\p"
    "All those who gave advice on the Team Aqua's Hideout Discord!\n"
    "<><><><>\p"
    "All those who have contributed to Pokeemerald and Pokeemerald-Expanded, making this possible!\n"
    "<><><><>\p"
    "Now, Emerald credits:")
    waitmessage
    closemessage
    special(GameClear)
    release
    end
}