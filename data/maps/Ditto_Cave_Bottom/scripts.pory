mapscripts Ditto_Cave_Bottom_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Ditto_Cave_Bottom_Enter
}

script Ditto_Cave_Bottom_Enter {
	setvar(VAR_TEMP_2, 0)
}

script Ditto_Cave_Bottom_DittoTrainer {
	trainerbattle_single(TRAINER_MITCHELL, Ditto_Cave_Bottom_Ditto_Intro, Ditto_Cave_Bottom_Ditto_Outro)
	fadeScreen(FADE_TO_BLACK)
	setflag(FLAG_UNUSED_0x03C)
	removeobject(1)
	clearflag(FLAG_HIDE_ROUTE_111_GABBY_AND_TY_3)
	clearflag(FLAG_HIDE_ROUTE_118_GABBY_AND_TY_2)
	clearflag(FLAG_HIDE_ROUTE_120_GABBY_AND_TY_2)
	addobject(3)
	addobject(4)
	addobject(5)
	fadeScreen(FADE_FROM_BLACK)
	setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
	msgbox("It was just a ditto...")
	closemessage
	callnative(ClearMugshot)

	if (var(VAR_DAILY_SLOTS) >= 2) {
		setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
		callnative(DrawMugshot)
		msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Oh... Well, yeah, I knew that.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
		waitmessage
		closemessage
		callnative(ClearMugshot)
	}

	setvar(VAR_0x8000, SPECIES_DITTO)
    callnative(RegisterSpeciesInDex)
	end
}

text Ditto_Cave_Bottom_Ditto_Intro {
	"!!!"
}

text Ditto_Cave_Bottom_Ditto_Outro {
	"Ditto!"
}

script Ditto_Cave_Bottom_EventScript_Item01 {
	lock
	giveitem(ITEM_SUN_STONE, 1)
	removeobject(2)
	setflag(FLAG_TEMP_1)
	release
	end
}

script Ditto_Cave_Bottom_EventScript_Item02 {
	lock
	giveitem(ITEM_SUN_STONE, 1)
	removeobject(6)
	setflag(FLAG_TEMP_2)
	release
	end
}

script Ditto_Cave_Bottom_HintText01 {
	lock
	msgbox("Biologist: I discovered a strange\n"
    "kind of life down here, with the ditto.\l"
    "It has a strange power to it. I need to\l"
	"take it to our lab above the waterfall\l"
	"and study it, immediately.")
	closemessage

	if (var(VAR_TEMP_2) == 0) {
		if (var(VAR_DAILY_SLOTS) >= 2) {
			setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
			callnative(DrawMugshot)
			msgbox("{COLOR RED}{SHADOW LIGHT_RED}<This is where I found it...\n"
			"Or, it found me. It hurts to see this\l"
			"place again.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
			waitmessage
			closemessage
			callnative(ClearMugshot)
		}
        setvar(VAR_TEMP_2, 1)
    }

	release
	end
}

script Ditto_Boi {
	lockall
	faceplayer
	setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("You put up a good fight, buddy.")
    waitmessage
    callnative(ClearMugshot)
    release
	setvar(VAR_0x8000, MUGSHOT_DITTO)
    callnative(DrawMugshot)
	msgbox("DITTO!")
	waitmessage
    callnative(ClearMugshot)
	release
	end
}