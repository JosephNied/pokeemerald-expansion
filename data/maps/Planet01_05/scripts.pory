mapscripts Planet01_05_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_05_Enter
}

script Planet01_05_Enter {
	special(SetRandomFlags)
    if(flag(FLAG_UNUSED_0x03A) == FALSE) {
        setvar(VAR_TEMP_0, 0)
    } else {
        setvar(VAR_TEMP_0, 1)
    }
}

script Planet01_05_DusknoirEncounter {
    lockall
    msgbox("A terrifying Pokémon bursts out\n"
			"of the darkness!")
    applymovement(3, Movement_DusknoirAppears)
    waitmovement(0)

    waitse()
    playmoncry(SPECIES_DUSKNOIR, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry()

    special(SetBossBattle)
    setwildbattle(
        SPECIES_DUSKNOIR,
        75,
        ITEM_NONE
    )
    dowildbattle
    special(BossBattleOff)

    compare(VAR_RESULT, FALSE)
    goto_if_eq(PlayerLost_Dusknoir)

    removeobject(3)
    setflag(FLAG_UNUSED_0x03A)

    msgbox("Dusknoir faded into the \n"
    "shadows.")
    releaseall
    end

PlayerLost_Dusknoir:
    releaseall
    end

DusknoirTrigger_End:
    end
}

movement Movement_DusknoirAppears {
    face_up
    set_visible
    delay_4
    set_invisible
    delay_4
    set_visible
    delay_4
    set_invisible
    delay_4
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
    delay_16
    set_invisible
    delay_16
    set_visible
}