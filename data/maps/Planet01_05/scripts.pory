mapscripts Planet01_05_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_05_Enter
}

script Planet01_05_Enter {
	special(SetRandomFlags)
    if(flag(FLAG_UNUSED_0x03A) == FALSE) {
        setvar(VAR_TEMP_0, 0)
    } else {
        setvar(VAR_TEMP_0, 1)
    }
}

script Planet01_05_DusknoirEncounter {
    lockall
    msgbox("A terrifying Pokémon bursts out\n"
			"of the darkness!")
    applymovement(3, Movement_DusknoirAppears)
    waitmovement(0)

    waitse()
    playmoncry(SPECIES_DUSKNOIR, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry()

    special(SetBossBattle)
    setwildbattle(
        SPECIES_DUSKNOIR,
        75,
        ITEM_NONE
    )
    dowildbattle
    special(BossBattleOff)

    compare(VAR_RESULT, FALSE)
    goto_if_eq(PlayerLost_Dusknoir)

    fadeScreen(FADE_TO_BLACK)
    setflag(FLAG_UNUSED_0x03A)
    removeobject(3)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("The Dusknoir faded into the\n"
    "shadows.")
    setvar(VAR_0x8000, SPECIES_DUSKNOIR)
    callnative(RegisterSpeciesInDex)
    setvar(VAR_TEMP_0, 1)
    releaseall
    end

PlayerLost_Dusknoir:
    releaseall
    end

DusknoirTrigger_End:
    end
}

movement Movement_DusknoirAppears {
    face_up
    set_visible
    delay_4
    set_invisible
    delay_4
    set_visible
    delay_4
    set_invisible
    delay_4
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
    delay_16
    set_invisible
    delay_16
    set_visible
}

script Planet01_05_HintText01 {
    lock
    msgbox("Engineer: The trees here are giving off\n"
    "a mysterious glow... The mists here\l"
    "remind me of the anomalous cave we\l"
    "discovered earlier.\p"
    "We'll do what research we can here, and\n"
    "go there at our next opportunity in\l"
    "case there is a connection.\p"
    "These Duskull are freaking me out\n"
    "anyway.")
    release
    end
}

script Color_Puzzle {
    lock
    msgbox ("A mesmerizing, iridescent rock...")
    setvar(VAR_DAILY_ROULETTE, 0)
    msgbox ("You begin to focus on a color...")
    multichoice(0, 0, MULTI_COLOR_PUZZLE, FALSE)
    if (var(VAR_RESULT) == 0) {
        addvar(VAR_DAILY_ROULETTE, 1)
    }
    msgbox ("...And another...")
    multichoice(0, 0, MULTI_COLOR_PUZZLE, FALSE)
    if (var(VAR_RESULT) == 2) {
        addvar(VAR_DAILY_ROULETTE, 1)
    }
    msgbox ("Hypnotized, by another...")
    multichoice(0, 0, MULTI_COLOR_PUZZLE, FALSE)
    if (var(VAR_RESULT) == 3) {
        addvar(VAR_DAILY_ROULETTE, 1)
    }
    msgbox ("Drawn into another color...")
    multichoice(0, 0, MULTI_COLOR_PUZZLE, FALSE)
    if (var(VAR_RESULT) == 1) {
        addvar(VAR_DAILY_ROULETTE, 1)
    }
    if (var(VAR_DAILY_ROULETTE) == 4) {
    warp(MAP_PLANET01_FINAL_LAB_CORE, 1, 0, 0)
    waitstate
    release
    end
    }
    else {
    setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox("Snap out of it!\n"
    "I should use my teleporter to get back\l" 
    "to the ship already.")
    waitmessage
    closemessage
    callnative(ClearMugshot)
    release
    end
    }
}