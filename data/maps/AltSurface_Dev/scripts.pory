mapscripts AltSurface_Dev_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: AltSurface_Dev_Enter
}

script AltSurface_Dev_Enter {
	special(SetRandomFlags)
	end
}

script AltSurface_Dev_MapScripts_UrsalunaEncounter {
    lock
    setwildbattle(SPECIES_URSALUNA, 70, ITEM_LUM_BERRY)
	dowildbattle
	if (var(VAR_RESULT) == 0) 
	{
		setflag(FLAG_UNUSED_0x034)
	}
    release
    end
}

script AltSurface_Dev_EventScript_RandomItem01 {
    lock
    faceplayer

    random(4)

    if (var(VAR_RESULT) == 0) {
        giveitem(ITEM_MAX_REVIVE, 1)
	}
	elif (var(VAR_RESULT) == 1) {
        giveitem(ITEM_MAX_POTION, 1)
	}
	elif (var(VAR_RESULT) == 2) {
        giveitem(ITEM_LUM_BERRY, 1)
	}
	else {
        giveitem(ITEM_SITRUS_BERRY, 1)
	}
    setflag(FLAG_UNUSED_0x020)
    removeobject(12)
    release
    end
}

