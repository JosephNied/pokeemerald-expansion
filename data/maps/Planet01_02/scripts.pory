script Planet01_02_AddAir_Minior01 {
    lockall
    setvar(VAR_AIR_TIMER_STEPS, 250)
    special(AddAirTimerMap)
    playmoncry(SPECIES_MINIOR, CRY_MODE_ENCOUNTER)
    setvar(VAR_0x8000, SPECIES_MINIOR)
    callnative(RegisterSpeciesInDex)
    msgbox("Minior is floating in a pocket of air!\n"
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Oxygen captured!")
    setflag(FLAG_UNUSED_0x02F)
    fadeScreen(FADE_TO_BLACK)
    callnative(RefreshO2Meter)
    removeobject(28)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("Minior flew away...")
    releaseall
    end
}

