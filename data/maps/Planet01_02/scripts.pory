script Planet01_02_Carbink {
    lock
    faceplayer
    playmoncry(SPECIES_CARBINK, CRY_MODE_ENCOUNTER)
    setvar(VAR_0x8000, SPECIES_CARBINK)
    callnative(RegisterSpeciesInDex)
    msgbox("The Carbink seems lost...!")
    setflag(FLAG_UNUSED_0x04D)
    fadeScreen(FADE_TO_BLACK)
    removeobject(6)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}Carbink climbed into your bag!")
    giveitem(ITEM_CHIPPED_POT, 1)
    release
    end
}

script Jirachi_goes_to_ship {
    lock
    faceplayer
    playmoncry(SPECIES_JIRACHI, CRY_MODE_ENCOUNTER)
    setvar(VAR_0x8000, SPECIES_CARBINK)
    callnative(RegisterSpeciesInDex)
    msgbox("Jirachi wants to join your crew-!")
    setflag(FLAG_TEMP_1)
    fadeScreen(FADE_TO_BLACK)
    setflag(FLAG_REGISTERED_ANDRES)
    clearflag(FLAG_REGISTERED_DUSTY)
    removeobject(27)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}Jirachi went to your ship!")
    release
    end
}

script Planet01_02_HintText01 {
    lock
    msgbox("Engineer: Note to self. Do not wear\n"
    "sweet smelling perfume the next time\l"
    "I climb this mountain.\p"
    "There's a strong pokemon at the top\n"
    "who is too much of a fan of it!")
    release
    end
}

script Planet01_02_HintText02 {
    lock
    msgbox("Biologist: I've occasionally observed a\n"
    "Quagsire that seems to enjoy collecting\l"
    "pretty blue stones near the waterfall.\p"
    "How cute! Could they be Water Stones?")
    release
    end
}

script Planet01_02_HintText03 {
    lock
    msgbox("Captain: To future explorers:\n"
    "Our team has setup our primary lab in\l"
    "the cave above this waterfall.\p"
    "You may be able to find our previous\n"
    "campsites to the south.")
    release
    end
}

script Planet01_02_HintText04 {
    lock
    msgbox("Engineer: We couldn't find a Pokemon\n"
    "on this planet with the move {COLOR BLUE}{SHADOW LIGHT_BLUE}Waterfall;\l"
    "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}thankfully had brought our own.")
    release
    end
}

script Planet01_02_HintText05 {
    lock
    msgbox("Scientist: There's a suprising amount\n"
    "of greenery here for a planet with such\l"
    "a light atmosphere.")
    release
    end
}

script Planet01_02_HintText06 {
    lock
    msgbox("That concludes the demo!\n"
    "Thanks for playing!")
    release
    end
}