mapscripts Planet01_02_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_01_Enter
}

script Planet01_02_Enter {
	special(SetRandomFlags)
	clearflag(FLAG_TEMP_10)
	clearflag(FLAG_TEMP_11)
	clearflag(FLAG_TEMP_12)
	clearflag(FLAG_TEMP_13)
	clearflag(FLAG_TEMP_14)
	clearflag(FLAG_TEMP_15)
	clearflag(FLAG_TEMP_16)
	end
}

script Planet01_02_EventScript_Item01 {
    lock
    giveitem(ITEM_SITRUS_BERRY, 1)
    removeobject(24)
    setflag(FLAG_UNUSED_0x495)
    release
    end
}

script Planet01_02_EventScript_Item02 {
    lock
    giveitem(ITEM_STARDUST, 1)
    setflag(FLAG_UNUSED_0x496)
    removeobject(23)
    release
    end
}

script Planet01_02_AddAir_Minior01 {
    lockall
    setvar(VAR_AIR_TIMER_STEPS, 150)
    special(AddAirTimerMap)
    msgbox("Minior is floating in a pocket of air!\n"
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Oxygen captured!")
    setflag(FLAG_UNUSED_0x02F)
    fadeScreen(FADE_TO_BLACK)
    removeobject(9)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("Minior flew away...")
    releaseall
    end
}

script Planet01_02_EventScript_RockSmash01 {
    lock
    faceplayer
    call(EventScript_RockSmash)
    setflag(FLAG_TEMP_10)
    release
    end
}

