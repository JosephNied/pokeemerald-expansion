script Planet01_02_Carbink {
    lock
    faceplayer
    playmoncry(SPECIES_CARBINK, CRY_MODE_ENCOUNTER)
    setvar(VAR_0x8000, SPECIES_CARBINK)
    callnative(RegisterSpeciesInDex)
    msgbox("The Carbink seems lost...!")
    setflag(FLAG_UNUSED_0x04D)
    fadeScreen(FADE_TO_BLACK)
    removeobject(29)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}Carbink climbed into your bag!")
    giveitem(ITEM_CHIPPED_POT, 1)
    release
    end
}

script Jirachi_goes_to_ship {
    lock
    faceplayer
    playmoncry(SPECIES_JIRACHI, CRY_MODE_ENCOUNTER)
    setvar(VAR_0x8000, SPECIES_CARBINK)
    callnative(RegisterSpeciesInDex)
    msgbox("Jirachi wants to join your crew-!")
    setflag(FLAG_TEMP_1)
    fadeScreen(FADE_TO_BLACK)
    setflag(FLAG_REGISTERED_ANDRES)
    clearflag(FLAG_REGISTERED_DUSTY)
    removeobject(25)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}Jirachi went to your ship!")
    release
    end
}

script Found_Ruby {
    lock
    faceplayer
    setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("Found the Ruby!\n"
    "Let's get the heck out of here!")
    waitmessage
    closemessage
    callnative(ClearMugshot)
    warp(MAP_SPACESHIP_DEV, 0, 12, 7)
    waitstate
    release
    end
}

script Planet01_02_HintText01 {
    lock
    msgbox("Engineer: Note to self. Do not wear\n"
    "sweet smelling perfume the next time\l"
    "I climb this mountain.\p"
    "There's a strong pokemon at the top\n"
    "who is too much of a fan of it!")
    if (var(VAR_CAPTAIN_DIALOGUE) == 1) {
        clearflag(FLAG_REGISTERED_CRISTIN)
    } elif (var(VAR_CAPTAIN_DIALOGUE) == 2) {
        clearflag(FLAG_REGISTERED_CRISTIN)
    } else  {
        setflag(FLAG_REGISTERED_CRISTIN)
    }
    if (var(VAR_DAILY_SLOTS) == 0) {
        setvar(VAR_DAILY_SLOTS, 1)
    }
    release
    end
}

script Planet01_02_HintText02 {
    lock
    msgbox("Biologist: I've occasionally observed\n"
    "Quagsires bringing blue stones they've\l"
    "found to a nest behind the waterfall.\p"
    "How cute! Could they be Water Stones?")
    if (var(VAR_CAPTAIN_DIALOGUE) == 1) {
        clearflag(FLAG_REGISTERED_CRISTIN)
    } elif (var(VAR_CAPTAIN_DIALOGUE) == 2) {
        clearflag(FLAG_REGISTERED_CRISTIN)
    } else  {
        setflag(FLAG_REGISTERED_CRISTIN)
    }
    if (var(VAR_DAILY_SLOTS) == 0) {
        setvar(VAR_DAILY_SLOTS, 1)
    }
    release
    end
}

script Planet01_02_HintText03 {
    lock
    msgbox("Captain: To future explorers:\n"
    "Our team has setup our primary lab in\l"
    "the cave above this waterfall.\p"
    "You may be able to find our previous\n"
    "campsites to the south.")
    if (var(VAR_CAPTAIN_DIALOGUE) == 1) {
        clearflag(FLAG_REGISTERED_CRISTIN)
    } elif (var(VAR_CAPTAIN_DIALOGUE) == 2) {
        clearflag(FLAG_REGISTERED_CRISTIN)
    } else  {
        setflag(FLAG_REGISTERED_CRISTIN)
    }
    if (var(VAR_DAILY_SLOTS) == 0) {
        setvar(VAR_DAILY_SLOTS, 1)
    }
    waitmessage
    closemessage

    setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    callnative(DrawMugshot)
    msgbox ("Welp. I don't have any way to get\n"
    "up there right now. Guess I'll have\l"
    "to start searching the old campsites.\l"
    "This is the only lead I've got.")
    waitmessage
    closemessage
    callnative(ClearMugshot)

    setvar (VAR_CAPTAIN_DIALOGUE, 3)

    release
    end
}

script Planet01_02_HintText04 {
    lock
    msgbox("Engineer: We couldn't find a Pokemon\n"
    "on this planet with the move {COLOR BLUE}{SHADOW LIGHT_BLUE}Waterfall;\l"
    "{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}thankfully had brought our own.")
    release
    end
}

script Planet01_02_HintText05 {
    lock
    msgbox("Scientist: There's a suprising amount\n"
    "of greenery here for a planet with such\l"
    "a light atmosphere.")
    release
    end
}

script Planet01_02_HintText06 {
    lock
    msgbox("WILD INDIGO LAB Ahead")
    release
    end
}

script Planet01_02_QuagsireTrigger {
    lockall
    setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    callnative(DrawMugshot)
    msgbox("Huh? In the waterfall-")
    waitmessage
    callnative(ClearMugshot)
    closemessage
    waitse()
    playmoncry(SPECIES_QUAGSIRE, CRY_MODE_ENCOUNTER)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(emote_exclamation_mark, face_right))
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(26, Movement_QuagsireWaterstone1)
    waitmovement(0)
    setwildbattle(
        SPECIES_CARNIVINE,
        50,
        ITEM_WATER_STONE
    )
    dowildbattle
    setflag(FLAG_TEMP_4)
    removeobject(26)
    setvar(VAR_TEMP_1, 1)
    releaseall
    end
}

movement Movement_QuagsireWaterstone1 {
    face_left
    walk_left
    walk_left
    delay_16
    delay_16
    jump_left
    jump_down
    face_left
    walk_left
}

script Planet01_02_Elgyem {
    lock
    faceplayer
    playmoncry(SPECIES_ELGYEM, CRY_MODE_ENCOUNTER)
    setvar(VAR_0x8000, SPECIES_ELGYEM)
    callnative(RegisterSpeciesInDex)
    msgbox("Elgyem seems taken off-guard!\n"
    "My bad- Huh?! It's flashing blue-")
    waitmessage
    warp(MAP_PLANET01_03, 2, 11, 2)
    waitstate
    release
    end
}