mapscripts Planet01_ICE_CAVE_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_ICE_CAVE_Enter
}

script Planet01_ICE_CAVE_Enter {
	special(SetRandomFlags)
	if((var(VAR_DAILY_SLOTS) == 1) || (var(VAR_DAILY_SLOTS) == 2)) {
        setvar(VAR_TEMP_2, 0)
    } else {
		setvar(VAR_TEMP_2, 1)
	}
}

script Planet01_Ice_Cave_EventScript_Item01 {
	lock
	giveitem(ITEM_STARDUST, 1)
	removeobject(9)
	setflag(FLAG_UNUSED_0x49D)
	release
	end
}

script Planet01_Ice_Cave_EventScript_Item02 {
	lock
	giveitem(ITEM_SITRUS_BERRY, 1)
	removeobject(8)
	setflag(FLAG_UNUSED_0x49E)
	release
	end
}

script Planet01_Ice_Cave_Carbink {
    lock
    faceplayer
	playmoncry(SPECIES_CARBINK, CRY_MODE_ENCOUNTER)
	setvar(VAR_0x8000, SPECIES_CARBINK)
    callnative(RegisterSpeciesInDex)
    msgbox("The Carbink is chilly...")
    setflag(FLAG_UNUSED_0x04C)
    fadeScreen(FADE_TO_BLACK)
    removeobject(11)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("{COLOR BLUE}{SHADOW LIGHT_BLUE}Carbink climbed into your bag!")
    giveitem(ITEM_CHIPPED_POT, 1)
    release
    end
}

script EventScript_GlalieCatch {
	lockall
	fadeScreen(FADE_TO_WHITE)
	special(GlalieCatch)
	setflag(FLAG_UNUSED_0x02D)
	setflag(FLAG_UNUSED_0x032)
    removeobject(3)
	removeobject(10)
    fadeScreen(FADE_FROM_WHITE)
	setvar(VAR_0x8000, SPECIES_GLALIE)
    callnative(RegisterSpeciesInDex)
	msgbox("Glalie froze a party member!\n"
	"They're frozen solid!")
	release
	end
}

script voicetrigger_icecave {
	lock
    call(voicedialogueABC)
    setvar(VAR_TEMP_2, 1)
	release
	end
}