mapscripts Planet01_First_Camp_Cave_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_First_Camp_Cave_Enter
}

script Planet01_First_Camp_Cave_Enter {
	//clearflag(FLAG_UNUSED_0x02A)
    setvar(VAR_TEMP_2, 0)
	end
}

script Planet01_First_Camp_Cave_UrsalunaEncounter {
    lockall
    faceplayer

    msgbox("The enormous Pokémon lets out\n"
			"a deafening roar!")

    special(SetBossBattle)
    setwildbattle(
        SPECIES_URSALUNA,
        75,
        ITEM_NONE
    )
    dowildbattle
    special(BossBattleOff)

    compare(VAR_RESULT, FALSE)
    goto_if_eq(PlayerLost)

    setflag(FLAG_UNUSED_0x03B)
    removeobject(1)

    msgbox("The Ursaluna disappeared into the\n"
    "cave.")
    setvar(VAR_0x8000, SPECIES_URSALUNA)
    callnative(RegisterSpeciesInDex)
    releaseall
    end

PlayerLost:
    releaseall
    end
}

script Planet01_First_Camp_Cave_EventScript_Item01 {
	lock
	giveitem(ITEM_STAR_PIECE, 1)
	removeobject(3)
	setflag(FLAG_UNUSED_0x49B)
	release
	end
}

script Planet01_First_Camp_Cave_EventScript_Item02 {
	lock
	giveitem(ITEM_STARDUST, 1)
	removeobject(2)
	setflag(FLAG_UNUSED_0x49C)
	release
	end
}

script Planet01_First_Camp_Cave_EventScript_Item03 {
	lock
	giveitem(ITEM_TM_PROTECT, 1)
	removeobject(5)
	setflag(FLAG_DEFEATED_RUSTBORO_GYM)
	release
	end
}

script Planet01_First_Camp_Cave_HintText01 {
    lock
    msgbox("Engineer: We made a research base\n"
    "here, but the local fauna discovered it\l"
    "and got aggressive, so we better move.\p"
    "There's another cave across the shore,\n"
    "maybe we can check it out?\p"
    "We might need to use our pokemon to dig\n"
    "around and create a wall between us and\l"
    "the icy caverns, though I do want to \l"
    "explore those too.")
    waitmessage
    closemessage
    delay(60)

    setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    callnative(DrawMugshot)
    msgbox("I was hoping to find these guys\n"
    "by now...")
    waitmessage
    callnative(ClearMugshot)
    release

    if (var(VAR_TEMP_2) == 0) {
        call(voicedialogueABC)
        setvar(VAR_TEMP_2, 1)
    }

    release
    end
}

script groundjournal_1 {
    lock

    setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("Oh wow, a journal!")
    waitmessage
    callnative(ClearMugshot)

    msgbox("Biologist: Though the water here is\n" 
    "safe for our Pokémon to drink, it\l"
    "transformed them in an unexpected way. \l"
    "They changed colors: The Engineer's \l"
    "Excadrill and Kingdra, my Venusaur and \l"
    "Charizard, and Ops' Haxorus. Ops' \l"
    "Dragonite, however, was fine; I really \l"
    "want to figure out why Dragonite in \l"
    "particular is so resilient to change.")
    release
    end
}

script voicedialogueABC {
    if (var(VAR_DAILY_SLOTS) == 0) {
        setvar(VAR_0x8004, 1)
        setvar(VAR_0x8005, 1)
        setvar(VAR_0x8006, 8)
        setvar(VAR_0x8007, 5)
        special(ShakeCamera)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
        callnative(DrawMugshot)
        msgbox("Woah, what's going on?\n"
        "...I want to go check on my ship.")
        waitmessage
        callnative(ClearMugshot)
        warp(MAP_SPACESHIP_DEV, 0, 12, 7)
        clearflag(FLAG_REGISTERED_CRISTIN)
        waitstate
        releaseall
        end
    }
    elif(var(VAR_DAILY_SLOTS) == 1) {
        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<A fly, caught in a web. I'm surprised\n" 
        "you're still whole, to be honest.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
        callnative(DrawMugshot)
        msgbox("You again! Enough with the games! Just\n" 
        "tell me who you are!")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Who am I... Good question... Nothing\n"
        "important. In truth, I was going to tell\l" 
        "you how you might escape by getting to\l"
        "the research facility at the top of the\l"
        "waterfall. But, I guess I still don't\l"
        "know if that's what I want... I don't\l"
        "mean you any harm. But it's probably\l"
        "better you don't listen to me; a lost\l"
        "soul in the dark. However you choose to\l"
        "end this... I'm sorry.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox("Look, you're clearly going through a\n" 
        "time, but I don't want to be here. Just\l"
        "tell me what I need to do to get my ship\l"
        "off the ground.\p"
        "Hello? Hello?!?!\p"
        "...Gone again? Damn.")
        waitmessage
        callnative(ClearMugshot)
        addvar(VAR_DAILY_SLOTS, 1)
    }
    elif(var(VAR_DAILY_SLOTS) == 2) {
        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<I see you're persevering.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox("You again? Got anything meaningful to\n"
        "say?")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<...>\n"
        "<I decided. You need to come to the \l"
        "primary facility. I don't know how to \l"
        "get you up the waterfall, but when you\l"
        "get there, I can guide you. I regret\l"
        "being a coward about this.\p"
        "Please don't give up.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
        callnative(DrawMugshot)
        msgbox("Wow, that's a change in tune! Are you\n
        ready then to tell me who you are?")
        waitmessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<...I would be, the one you've read\n"
        "about, the Biologist...>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
        callnative(DrawMugshot)
        msgbox("Ok. Interesting. Got a name?")
        waitmessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<...>\p"
        "<We-, I-, ...a miscalculation was made.\n"
        "If it wasn't obvious, the space virus is\l"
        "some form of Deoxys. Its psychic power\l"
        "is holding your ship. Defeat Deoxys,\l"
        "and you might be able to escape.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox("I have to do that?! So what are you\n"
        "up to then?")
        waitmessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<You'll see. Just know, I am helping.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox("...How, exactly?")
        waitmessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<I'll explain later... my only advice...\n"
        "The north and south of this planet, we\l"
        "never fully explored. Look there.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
        callnative(DrawMugshot)
        msgbox("Ok. Well, I guess this is progress.")
        waitmessage
        callnative(ClearMugshot)
        addvar(VAR_DAILY_SLOTS, 1)
    }
    elif(var(VAR_DAILY_SLOTS) == 4) {
        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Hey... Those infected monsters are\n"
        "coming back. You can't understand now,\l"
        "but I've been trying to hold them back.\l"
        "Sorry I'm not stronger. I recommend\l"
        "you walk slowly, running with likely\l"
        "alert them.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
        callnative(DrawMugshot)
        msgbox("Wow, really? Are you, like ok?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Am I... Ok?\p"
        "You're starting to sounds like- Well,\n"
        "whatever.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
        callnative(DrawMugshot)
        msgbox("...We're partners now. You're the last\n"
        "person I might ever talk to. I'd prefer\l"
        "if we could be friends.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Now you really sound like them. I can't\n"
        "be much of a 'friend.'>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
        callnative(DrawMugshot)
        msgbox("Pssh, ok, 'Shadow the Edgehog.'")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Ugghhh>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)


        setvar(VAR_DAILY_SLOTS, 6)
        release
    }
    elif(var(VAR_DAILY_SLOTS) == 5) { 

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Well, then. You're quite the scientist\n"
        "yourself. I'll be waiting at the top.\l"
        "I recommend you prepare your team.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
        callnative(DrawMugshot)
        msgbox("...Yeah. Got it.")
        waitmessage
        callnative(ClearMugshot)
    }
    else {
        end
    }
}