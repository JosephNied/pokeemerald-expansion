mapscripts Planet01_First_Camp_Cave_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_First_Camp_Cave_Enter
}

script Planet01_First_Camp_Cave_Enter {
	//clearflag(FLAG_UNUSED_0x02A)
    setvar(VAR_TEMP_2, 0)
	end
}

script Planet01_First_Camp_Cave_UrsalunaEncounter {
    lockall
    faceplayer

    msgbox("The enormous Pokémon lets out\n"
			"a deafening roar!")

    special(SetBossBattle)
    setwildbattle(
        SPECIES_URSALUNA,
        75,
        ITEM_NONE
    )
    dowildbattle
    special(BossBattleOff)

    compare(VAR_RESULT, FALSE)
    goto_if_eq(PlayerLost)

    fadeScreen(FADE_TO_BLACK)

    setflag(FLAG_UNUSED_0x03B)
    removeobject(1)

    msgbox("The Ursaluna scampered away.")
    waitmessage
    closemessage
    fadeScreen(FADE_FROM_BLACK)

    setvar(VAR_0x8000, SPECIES_URSALUNA)
    callnative(RegisterSpeciesInDex)
    releaseall
    end

PlayerLost:
    releaseall
    end
}

script Planet01_First_Camp_Cave_EventScript_Item01 {
	lock
	giveitem(ITEM_STAR_PIECE, 1)
	removeobject(3)
	setflag(FLAG_UNUSED_0x49B)
	release
	end
}

script Planet01_First_Camp_Cave_EventScript_Item02 {
	lock
	giveitem(ITEM_STARDUST, 1)
	removeobject(2)
	setflag(FLAG_UNUSED_0x49C)
	release
	end
}

script Planet01_First_Camp_Cave_EventScript_Item03 {
	lock
	giveitem(ITEM_TM_PROTECT, 1)
	removeobject(5)
	setflag(FLAG_DEFEATED_RUSTBORO_GYM)
	release
	end
}

script Planet01_First_Camp_Cave_HintText01 {
    lock
    msgbox("Ops Lead: We made a research base\n"
    "here, but the local fauna discovered it\l"
    "and is getting aggressive, so we'll move.\p"
    "There's another cave across the shore,\n"
    "maybe we can check it out?\p"
    "We might need to use our pokemon to dig\n"
    "around and create a wall between us and\l"
    "the icy caverns, though I do want to \l"
    "explore those too.")
    waitmessage
    closemessage

    if (var(VAR_DAILY_SLOTS) == 0) {
        call(voicedialogueABC)
    }

    release
    end
}

script groundjournal_1 {
    lock

    setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
    callnative(DrawMugshot)
    msgbox("Oh wow, a journal!")
    waitmessage
    callnative(ClearMugshot)

    msgbox("Biologist: Getting to explore this\n" 
    "amazing planet with Ops has been a\l"
    "dream. Who knew that when we first met\l"
    "years ago we'd get such an\l"
    "opportunity?\p"
    "The Best part? The EDGE OF DAWN\n"
    "company is perfectly happy with us\l"
    "doing our research, our way.\p"
    "This is the perfect place for me to\n"
    "make my big discovery: The one that's\l"
    "gonna let Ops and I make our mark on\l"
    "scientific history.")
    release
    end
}

script voicedialogueABC {
    if (var(VAR_DAILY_SLOTS) == 0) {
        setvar(VAR_0x8004, 1)
        setvar(VAR_0x8005, 1)
        setvar(VAR_0x8006, 8)
        setvar(VAR_0x8007, 5)
        special(ShakeCamera)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
        callnative(DrawMugshot)
        msgbox("Woah, what's going on?\n"
        "...I want to go check on my ship.")
        waitmessage
        callnative(ClearMugshot)
        warp(MAP_SPACESHIP_DEV, 0, 12, 7)
        clearflag(FLAG_REGISTERED_CRISTIN)
        waitstate
        releaseall
        end
    }
    elif(var(VAR_DAILY_SLOTS) == 1) {
        special(Script_FadeOutMapMusic)
        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Can you hear me?>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
        callnative(DrawMugshot)
        msgbox("You again!")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<I've decided. We have an opportunity\n"
        "here to help each other.>")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        release
        
        setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
        callnative(DrawMugshot)
        msgbox("Help each other? But I still don't know\n"
        "what's going on.")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        release
        
        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Your ship being held down by the\n"
        "psychic power of the Deoxys Cell: An\l"
        "biological mass that Deoxys, the space\l"
        "virus Pokémon, spawns from.\p"
        "Your only escape is to defeat it.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox("Deoxys... Cell?! Good grief. But who are\n" 
        "you, and how is your voice in my head?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<I am- or, was- the Biologist on the EOD\n"
        "research team. The Deoxys Cell and I\l"
        "are both in the EOD lab above the\l"
        "waterfall.\p"
        "If you can defeat the Deoxys Cell, that\n"
        "will help me too with my... Unlucky\l"
        "situation. A situation that does have\l" 
        "the silver lining of allowing my mind to\l" 
        "project itself across the planet, hence\l"
        "our mental communication.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
        callnative(DrawMugshot)
        msgbox("That's wild. How do I get to you?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<I don't know how to get you up the \n"
        "waterfall yet, but this planet holds\l"
        "many surprises. That's all I have the\l"
        "chance to say for now. Good luck. And...\l"
        "Thank you.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
        callnative(DrawMugshot)
        msgbox("Ok. Well, that's progress!")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        delay(30)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
        callnative(DrawMugshot)
        msgbox("Wait, didn't Cap's Emergency Protocol\n"
        "thing supposedly send the crew home?\l"
        "Why would the Biologist be left behind?")
        waitmessage
        callnative(ClearMugshot)
        special(Overworld_PlaySpecialMapMusic)
        addvar(VAR_DAILY_SLOTS, 1)
    }
    elif(var(VAR_DAILY_SLOTS) == 2) {
        special(Script_FadeOutMapMusic)
        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Hello, TARC? I need to talk to you.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
        callnative(DrawMugshot)
        msgbox("You're back!")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Yes. Communication takes a lot of\n"
        "mental focus; focus that I need to use\l"
        "to keep the force of the Deoxys Cell\l"
        "at bay on this planet.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
        callnative(DrawMugshot)
        msgbox("Huh? Are you having some kind of\n"
        "psychic battle with the Deoxys Cell\l"
        "now?!")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Given I'm fully fused with it, it's\n"
        "really more of a... personal struggle?\p"
        "Deoxy's biological imperative is to\n"
        "spread, but my will can influence it as\l" 
        "well. I'm going to give you an opening to\l" 
        "attack it once you get to me.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
        callnative(DrawMugshot)
        msgbox("Woah there. You never mentioned that!\n"
        "...\p"
        "Wait, if I attack it... Am I attacking\n"
        "you? Hello?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        delay(30)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
        callnative(DrawMugshot)
        msgbox("Gone again.")
        waitmessage
        callnative(ClearMugshot)
        special(Overworld_PlaySpecialMapMusic)
        addvar(VAR_DAILY_SLOTS, 1)
    }
    elif(var(VAR_DAILY_SLOTS) == 4) {
        special(Script_FadeOutMapMusic)
        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<TARC. I can't hold them back anymore.\n"
        "The infected Pokemon are coming back.\l"
        "If you see them, try to walk slowly;\l"
        "running will alert them.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
        callnative(DrawMugshot)
        msgbox("Wow, really? Are you ok?")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Am I... Ok? You're starting to sound\n" 
        "like-\l"
        "...\p"
        "Well... It's kind of you to ask that, even\n"
        "though the answer is obviously no.\l" 
        "You don't even know me.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
        callnative(DrawMugshot)
        msgbox("We're partners now. You're the last\n"
        "person I might ever talk to. I'd prefer\l"
        "if we could be friends.")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Good point. Hope to see you soon...>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        closemessage
        callnative(ClearMugshot)

        special(Overworld_PlaySpecialMapMusic)
        setvar(VAR_DAILY_SLOTS, 6)
        release
    }
    elif(var(VAR_DAILY_SLOTS) == 5) { 

        setvar(VAR_0x8000, MUGSHOT_UNKNOWN)
        callnative(DrawMugshot)
        msgbox("{COLOR RED}{SHADOW LIGHT_RED}<Incredible. You're quite the scientist\n"
        "yourself! Terragem knows {COLOR BLUE}{SHADOW LIGHT_BLUE}Waterfall{COLOR RED}{SHADOW LIGHT_RED}; get\l"
        "up that waterfall and I'll guide you.>{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        waitmessage
        callnative(ClearMugshot)
        release

        setvar(VAR_0x8000, MUGSHOT_PLAYER_DETERMINED)
        callnative(DrawMugshot)
        msgbox("Got it!")
        waitmessage
        callnative(ClearMugshot)
    }
    else {
        end
    }
}