mapscripts Planet01_07_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_07_Enter
}

script Planet01_07_Enter {
	special(SetRandomFlags)
	if(flag(FLAG_UNUSED_0x88F) == FALSE) {
        setvar(VAR_TEMP_0, 0)
    } else {
        setvar(VAR_TEMP_0, 1)
    }
	end
}

script Sun_Moon_Check {
	special(SunMoonCheck)
	if (var(VAR_RESULT) == TRUE) {
		lockall
		special(Script_FadeOutMapMusic)
		setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    	callnative(DrawMugshot)
		msgbox("You can see the sun and moon of the\n"
		"planet here. What an incredible sight!\p"
		"...Huh?")
		waitmessage
		closemessage
		callnative(ClearMugshot)
		playmoncry(SPECIES_JIRACHI, CRY_MODE_ENCOUNTER)
		applymovement(1, Movement_SunMoon_Jirachi)
		waitmovement(0)
		setvar(VAR_0x8004, 1)
		setvar(VAR_0x8005, 1)
		setvar(VAR_0x8006, 8)
		setvar(VAR_0x8007, 5)
		special(ShakeCamera)
		setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    	callnative(DrawMugshot)
		msgbox("Lunatone and Solrock are reacting\n"
		"to the presence of Jirachi!")
		waitmessage
		closemessage
		callnative(ClearMugshot)
		setvar(VAR_0x8004, 1)
		setvar(VAR_0x8005, 1)
		setvar(VAR_0x8006, 8)
		setvar(VAR_0x8007, 5)
		special(ShakeCamera)
		delay(30)
		fadescreen(FADE_TO_WHITE)
		closemessage
		delay(60)
		fadescreen(FADE_FROM_WHITE)
		special(ReplaceSunMoonWithTerragem)
		playmoncry(SPECIES_CELEBI, CRY_MODE_ENCOUNTER)
		setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    	callnative(DrawMugshot)
		msgbox("Woah! Solrock and Lunatone have\n"
		"merged into one!\p"
		"...\p"
		"...Jirachi?")
		waitmessage
		closemessage
		callnative(ClearMugshot)
		setvar(VAR_0x8000, SPECIES_CELEBI)
    	callnative(RegisterSpeciesInDex)
		applymovement(1, Movement_SunMoon_Jirachi2)
		waitmovement(0)
		fadescreen(FADE_TO_WHITE)
		closemessage
		delay(60)
		removeobject(1)
		fadescreen(FADE_FROM_WHITE)
		special(Overworld_PlaySpecialMapMusic)
		givemon(SPECIES_CELEBI, 50)
		setflag(FLAG_UNUSED_0x88F)
		setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    	callnative(DrawMugshot)
		msgbox("...It looked reluctant to leave.")
		waitmessage
		closemessage
		callnative(ClearMugshot)
		setvar(VAR_DAILY_SLOTS, 5)
		call(voicedialogueABC)
		setvar(VAR_DAILY_SLOTS, 6)
		releaseall
	} else {
		lockall
		special(Script_FadeOutMapMusic)
		setvar(VAR_0x8000, MUGSHOT_PLAYER_SHOCK)
    	callnative(DrawMugshot)
		msgbox("You can see the sun and moon of the\n"
		"planet here. What an incredible sight!")
		waitmessage
		closemessage
		callnative(ClearMugshot)
		delay(60)
		setvar(VAR_0x8000, MUGSHOT_PLAYER_OK)
    	callnative(DrawMugshot)
		msgbox("...\n"
		"...\l"
		"...")
		waitmessage
		closemessage
		callnative(ClearMugshot)
		delay(60)
		setvar(VAR_0x8000, MUGSHOT_PLAYER_CONFUSED)
    	callnative(DrawMugshot)
		msgbox("Why do I feel like something\n"
		"was supposed to happen...")
		waitmessage
		closemessage
		callnative(ClearMugshot)
		special(Overworld_PlaySpecialMapMusic)
		releaseall
	}
	end
}

movement Movement_SunMoon_Jirachi {
    face_down
    set_visible
    delay_4
    set_invisible
    delay_4
    set_visible
    delay_4
    set_invisible
    delay_4
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
    delay_8
    set_invisible
    delay_8
    set_visible
    delay_16
    set_invisible
    delay_16
    set_visible
	delay_16
	delay_16
	delay_16
	delay_16
	walk_down
    walk_down
	delay_16
	delay_16
}

movement Movement_SunMoon_Jirachi2 {
    face_up
	delay_16
	delay_16
	walk_up
	delay_16
	delay_16
	walk_up
	delay_16
	delay_16
}

script Planet01_07_HintText01 {
    lock
    msgbox("Captain: We were able to witness the sun\n"
    "and moon of this planet from the peak.\p"
    "The Lunatone we caught began to faintly\n"
	"glow with incredible energy; I feel like\l"
	"something amazing would happen if we\l"
	"brought a Solrock here as well, but we\l"
	"haven't been able to find one.")
    release
    end
}

  script Planet01_07_EventScript_Item01 {
	lock
	giveitem(ITEM_SITRUS_BERRY, 1)
	removeobject(2)
	setflag(FLAG_UNUSED_0x4A0)
	release
	end
}

script sableye_07 {
	lock
	if (flag(FLAG_SYS_DOME_GOLD) == FALSE) {
		msgbox("Noctowl's eyes open...")
		fadeScreen(FADE_TO_BLACK)
		waitse()
		playmoncry(SPECIES_NOCTOWL, CRY_MODE_ENCOUNTER)
		waitmoncry()
		setflag(FLAG_SYS_DOME_GOLD)
		removeobject(11)
		addvar(VAR_DAILY_BLENDER, 1)
		if (var(VAR_DAILY_BLENDER) == 5) {
			msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}The gate is open.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
		} else {
		buffernumberstring(STR_VAR_1, VAR_DAILY_BLENDER)
		msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}{STR_VAR_1} of 5...{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
		}
		fadeScreen(FADE_FROM_BLACK)
		setvar(VAR_0x8000, SPECIES_NOCTOWL)
		callnative(RegisterSpeciesInDex)
	}
	release
	end
}