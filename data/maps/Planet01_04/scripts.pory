mapscripts Planet01_04_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Planet01_04_Enter
}

script Planet01_04_Enter {
	special(SetRandomFlags)
}

script Planet01_04_AddAir_Minior01 {
    lockall
    setvar(VAR_AIR_TIMER_STEPS, 250)
    special(AddAirTimerMap)
    playmoncry(SPECIES_MINIOR, CRY_MODE_ENCOUNTER)
    setvar(VAR_0x8000, SPECIES_MINIOR)
    callnative(RegisterSpeciesInDex)
    msgbox("Minior is floating in a pocket of air!\n"
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Oxygen captured!")
    setflag(FLAG_UNUSED_0x032)
    fadeScreen(FADE_TO_BLACK)
    callnative(RefreshO2Meter)
    removeobject(3)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("Minior flew away...")
    releaseall
    end
}

script Planet01_04_AddAir_Minior02 {
    lockall
    setvar(VAR_AIR_TIMER_STEPS, 250)
    special(AddAirTimerMap)
    playmoncry(SPECIES_MINIOR, CRY_MODE_ENCOUNTER)
    setvar(VAR_0x8000, SPECIES_MINIOR)
    callnative(RegisterSpeciesInDex)
    msgbox("Minior is floating in a pocket of air!\n"
    "{COLOR BLUE}{SHADOW LIGHT_BLUE}Oxygen captured!")
    setflag(FLAG_UNUSED_0x032)
    fadeScreen(FADE_TO_BLACK)
    callnative(RefreshO2Meter)
    removeobject(5)
    fadeScreen(FADE_FROM_BLACK)
    msgbox("Minior flew away...")
    releaseall
    end
}

script Planet01_04_EventScript_Item01 {
    lock
    giveitem(ITEM_STAR_PIECE, 1)
    removeobject(6)
    setflag(FLAG_UNUSED_0x499)
    release
    end
}

script Planet01_04_EventScript_Item02 {
    lock
    giveitem(ITEM_SITRUS_BERRY, 1)
    removeobject(7)
    setflag(FLAG_UNUSED_0x49F)
    release
    end
}

script Planet01_04_HintText01 {
    lock
    msgbox("Engineer: The cave above just sends us\n"
    "in circles. How is this even possible?!\l"
    "I will get to the bottom of this!\l"
    "...Literally!")
    if (var(VAR_CAPTAIN_DIALOGUE) == 1) {
        clearflag(FLAG_REGISTERED_CRISTIN)
    } elif (var(VAR_CAPTAIN_DIALOGUE) == 2) {
        clearflag(FLAG_REGISTERED_CRISTIN)
    }
    if (var(VAR_DAILY_SLOTS) == 0) {
        setvar(VAR_DAILY_SLOTS, 1)
    }
    release
    end
}

script Planet01_04_HintText02 {
    lock
    msgbox("Ops Lead: The watery path ahead\n"
    "will reveal an incredible view of the\l"
    "planet's celestial bodies. There's\l"
    "something important going on up there,\l"
    "I can feel it!")
    release
    end
}

script Planet01_04_HintText03 {
    lock
    msgbox("Captain: Looks like this planet isn't\n"
    "very large. It actually loops around\l"
    "here. We'll have mapped it all out in\l"
    "no time!")
    if (var(VAR_CAPTAIN_DIALOGUE) == 1) {
        clearflag(FLAG_REGISTERED_CRISTIN)
    } elif (var(VAR_CAPTAIN_DIALOGUE) == 2) {
        clearflag(FLAG_REGISTERED_CRISTIN)
    }
    if (var(VAR_DAILY_SLOTS) == 0) {
        setvar(VAR_DAILY_SLOTS, 1)
    }
    release
    end
}

script Planet01_04_Elgyem {
    lock
    faceplayer
    playmoncry(SPECIES_ELGYEM, CRY_MODE_ENCOUNTER)
    setvar(VAR_0x8000, SPECIES_ELGYEM)
    callnative(RegisterSpeciesInDex)
    msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}Woah! Elgyem is glowing green-{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
    waitmessage
    warp(MAP_PLANET01_02, 0, 21, 23)
    waitstate
    release
    end
}

script sableye_04 {
	lock
    if (flag(FLAG_SYS_DOME_SILVER) == FALSE) {
        msgbox("Noctowl's eyes open...")
        fadeScreen(FADE_TO_BLACK)
        waitse()
        playmoncry(SPECIES_NOCTOWL, CRY_MODE_ENCOUNTER)
        waitmoncry()
        setflag(FLAG_SYS_DOME_SILVER)
        removeobject(10)
        addvar(VAR_DAILY_BLENDER, 1)
        if (var(VAR_DAILY_BLENDER) == 5) {
            msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}The gate is open.{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        } else {
        buffernumberstring(STR_VAR_1, VAR_DAILY_BLENDER)
        msgbox("{COLOR GREEN}{SHADOW LIGHT_GREEN}{STR_VAR_1} of 5...{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}")
        }
        fadeScreen(FADE_FROM_BLACK)
        setvar(VAR_0x8000, SPECIES_NOCTOWL)
        callnative(RegisterSpeciesInDex)
    }
	release
	end
}