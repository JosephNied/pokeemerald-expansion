script TestZone_One_EventScript_Item01 {
    lock
    faceplayer

    giveitem(ITEM_MASTER_BALL, 1)

    if (var(VAR_RESULT) == FALSE) {
        msgbox("Your Bag is full.")
        release
        end
    }

    msgbox("Hot diggity!")

    setflag(FLAG_UNUSED_0x023)

    removeobject(6)

    release
    end
}

script TestZone_One_EventScript_RandomItem01 {
    lock
    faceplayer

    random(4)

    if (var(VAR_RESULT) == 0) {
        giveitem(ITEM_POTION, 1)
        msgbox("You found a Potion!")
	}
	elif (var(VAR_RESULT) == 1) {
        giveitem(ITEM_SUPER_POTION, 1)
        msgbox("You found a Super Potion!")
	}
	elif (var(VAR_RESULT) == 2) {
        giveitem(ITEM_REVIVE, 1)
        msgbox("You found a Revive!")
	}
	else {
        giveitem(ITEM_RARE_CANDY, 1)
        msgbox("You found a Rare Candy!")
	}

    setflag(FLAG_UNUSED_0x024)
    removeobject(7)

    release
    end
}

