script TestZone_One_EventScript_ExampleTrainer {
	trainerbattle_single(TRAINER_MAY_ROUTE_110_TORCHIC, May_Intro, May_Outro)
	msgbox(PostBattle_May, MSGBOX_AUTOCLOSE)
	waitmessage
	end
}

text May_Intro {
	"im stronk"
}

text May_Outro {
	"fake news"
}

text PostBattle_May {
	"Waaaaa!!!!"
}